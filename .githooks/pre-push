#!/usr/bin/env bash
# pre-push — qc-gate anti-skip forcing function.
#
# Blocks (or warns on) a push whose commit range touches a PROTECTED path without
# review evidence (a `QC-Verdict: PASS` trailer or a `.qc/<sha>.verdict.json`
# artifact). Strength is per-project config, resolved by scripts/resolve-qc-gate.sh
# (mode: block|warn|off). The goal: make "pushed without a qc gate" a loud,
# deliberate act (push refused, or `--no-verify` bypass) instead of a silent default.
#
# git feeds pushed refs on stdin as: <local_ref> <local_sha> <remote_ref> <remote_sha>
#
# A hook enforces the EXISTENCE of review evidence, never its QUALITY; --no-verify
# can bypass. That is acceptable — the point is to flip the default, not seal it.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
__PUSH_STDIN="$(cat || true)"
__PUSH_REMOTE="${1-}"

__TIG_LIB="$REPO_ROOT/.githooks/lib/test-identity-gate.sh"
if [ -r "$__TIG_LIB" ]; then
  # shellcheck disable=SC1090
  . "$__TIG_LIB"
  if ! test_identity_gate_bypassed; then
    printf '%s\n' "$__PUSH_STDIN" | test_identity_refuse_push_range "$__PUSH_REMOTE" || exit 1
  fi
fi

# --- backlog gate (peer_report_lost + the file gate on the pushed commit) ---
# Runs before the qc-gate so qc-gate `mode: off` cannot switch it off. Per pushed ref the range is
# the same one the qc-gate below uses: <remote_sha>..<local_sha>, or origin/HEAD..<local_sha> for a
# new remote branch (the whole history when origin/HEAD is unknown). A range that never touched the
# backlog is skipped. A remote sha this clone does not have is skipped with a printed line (fetch,
# then push again to have that range checked).
# Strength follows .claude/backlog-config.md `mode` (no config → warn: violations are printed, the
# push is never blocked).
__BL_GATE="$REPO_ROOT/scripts/check-backlog-entries.js"
__BL_PATHS="$REPO_ROOT/scripts/resolve-project-paths.sh"
if [ -r "$__BL_GATE" ] && [ -r "$__BL_PATHS" ] && command -v node >/dev/null 2>&1; then
  __BL_REL="$(bash "$__BL_PATHS" --target "$REPO_ROOT" --field backlog 2>/dev/null || echo none)"
  if [ -n "$__BL_REL" ] && [ "$__BL_REL" != "none" ]; then
    __bl_fail=0
    while read -r __bl_lref __bl_lsha __bl_rref __bl_rsha; do
      [ -z "${__bl_lsha:-}" ] && continue
      echo "$__bl_lsha" | grep -qE '^0+$' && continue
      if echo "${__bl_rsha:-}" | grep -qE '^0+$'; then
        __bl_base="$(git rev-parse --verify --quiet origin/HEAD 2>/dev/null || true)"
        if [ -n "$__bl_base" ]; then __bl_range="${__bl_base}..${__bl_lsha}"; else __bl_range="$__bl_lsha"; fi
      else
        if ! git cat-file -e "${__bl_rsha}^{commit}" 2>/dev/null; then
          printf 'backlog gate: %s: remote commit %s is not in this clone - range not checked (git fetch, then push again)\n' "${__bl_lref:-HEAD}" "$__bl_rsha" >&2
          continue
        fi
        __bl_range="${__bl_rsha}..${__bl_lsha}"
      fi
      [ -n "$(git rev-list -n1 "$__bl_range" -- "$__BL_REL" 2>/dev/null)" ] || continue
      __bl_out="$(node "$__BL_GATE" --backlog "$REPO_ROOT/$__BL_REL" --range "$__bl_range" 2>&1)"
      __bl_rc=$?
      if [ "$__bl_rc" -eq 1 ]; then
        printf '\n\033[1mbacklog gate: %s (%s) blocked\033[0m\n%s\n' "${__bl_lref:-HEAD}" "$__bl_range" "$__bl_out" >&2
        __bl_fail=1
      elif [ "$__bl_rc" -ne 0 ]; then
        printf 'backlog gate: WARNING could not check %s (%s), exit %s - NOT enforced\n%s\n' "${__bl_lref:-HEAD}" "$__bl_range" "$__bl_rc" "$__bl_out" >&2
      elif printf '%s' "$__bl_out" | grep -qE '"(new_count|warn_count)":[1-9]'; then
        # warn mode (or warn-level codes only): show the violations, never block.
        printf '\nbacklog gate: %s (%s) has violations - warning only, push not blocked\n%s\n' "${__bl_lref:-HEAD}" "$__bl_range" "$__bl_out" >&2
      fi
    done <<< "$__PUSH_STDIN"
    if [ "$__bl_fail" -ne 0 ]; then
      printf 'Fix: reply to the reporter and record it in Reply, or name the row Id in docs/plans/ or CHANGELOG.md; see references/backlog-entry.md.\n' >&2
      printf 'Deliberate bypass (logged by git): git push --no-verify\n\n' >&2
      exit 1
    fi
  fi
fi

RESOLVE="$REPO_ROOT/scripts/resolve-qc-gate.sh"
if [ ! -x "$RESOLVE" ]; then
  # Degrade open (a broken install must not wedge every push), but never silently.
  printf 'qc-gate: WARNING resolver %s missing - qc-gate NOT enforced (broken install?)\n' "$RESOLVE" >&2
  exit 0
fi

MODE="$("$RESOLVE" --field mode 2>/dev/null || echo block)"
[ "$MODE" = "off" ] && exit 0

PATHS_CSV="$("$RESOLVE" --field protected_paths 2>/dev/null || echo 'skills/,agents/,scripts/,references/,hooks/')"
EVIDENCE="$("$RESOLVE" --field evidence 2>/dev/null || echo trailer)"
IFS=',' read -r -a PROTECTED <<< "$PATHS_CSV"

# Outcome stage (opt-in). Resolved once; only this call shows resolver stderr
# (hatch notice and unknown-value fallback). mode: off already returned above.
OUTCOME="$("$RESOLVE" --field outcome || echo off)"
OUTCOME_RERUN="$("$RESOLVE" --field outcome_rerun 2>/dev/null || echo sample)"
OUTCOME_SAMPLE="$("$RESOLVE" --field outcome_sample 2>/dev/null || echo 20)"
OUTCOME_BUDGET_S="$("$RESOLVE" --field outcome_budget_s 2>/dev/null || echo 600)"
outcome_refused=0
if [ "$OUTCOME" = "block" ] && [ "$OUTCOME_RERUN" = "none" ]; then
  printf 'outcome gate: block needs a re-run; outcome_rerun none is warn-only. Treated as warn.\n' >&2
  OUTCOME="warn"
fi

ZERO_RE='^0+$'   # all-zero sha = branch create (no remote sha) or delete
violations=""

# The protected-path / evidence decision lives in ONE place, shared with the status
# fact (scripts/qc-evidence-status.js): scripts/lib/qc-evidence.sh.
__QC_LIB="$REPO_ROOT/scripts/lib/qc-evidence.sh"
if [ ! -r "$__QC_LIB" ]; then
  # Same posture as a missing resolver: degrade open, but loudly.
  printf 'qc-gate: WARNING shared decision lib %s missing - qc-gate NOT enforced (broken install?)\n' "$__QC_LIB" >&2
  exit 0
fi
# shellcheck disable=SC1090
. "$__QC_LIB"
touches_protected() { qc_touches_protected "$1"; }
has_evidence() { qc_has_evidence "$1"; }

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  echo "$local_sha" | grep -qE "$ZERO_RE" && continue   # branch delete → nothing to gate

  if echo "${remote_sha:-}" | grep -qE "$ZERO_RE"; then
    # new remote branch: gate the commits not already on the default remote branch.
    # If origin/HEAD doesn't resolve, range = whole branch history; ANY historical
    # QC-Verdict trailer then satisfies it (wider window — acceptable: --no-verify is
    # the escape hatch and the goal is to flip the default, not seal it).
    base="$(git rev-parse --verify --quiet origin/HEAD 2>/dev/null || true)"
    if [ -n "$base" ]; then range="${base}..${local_sha}"; else range="$local_sha"; fi
  else
    range="${remote_sha}..${local_sha}"
  fi

  # empty range (nothing new) → skip
  [ -n "$(git rev-list -n1 "$range" 2>/dev/null)" ] || continue

  if touches_protected "$range"; then
    if ! has_evidence "$range"; then
      violations="${violations}  • ${local_ref:-HEAD} (${range}) touches a protected path with no QC-Verdict evidence\n"
    fi
    if [ "$OUTCOME" != "off" ]; then
      __oc_checker="$REPO_ROOT/scripts/check-test-outcome.js"
      if ! command -v node >/dev/null 2>&1 || [ ! -f "$__oc_checker" ]; then
        printf 'outcome gate: WARNING could not check (exit 127) - NOT enforced\n' >&2
      else
        __oc_out="$(mktemp)"
        __oc_err="$(mktemp)"
        env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
          node "$__oc_checker" --root "$REPO_ROOT" --range "$range" --head "$local_sha" \
          --rerun "$OUTCOME_RERUN" --sample "$OUTCOME_SAMPLE" --budget-s "$OUTCOME_BUDGET_S" \
          >"$__oc_out" 2>"$__oc_err"
        __oc_rc=$?
        # A refuse always prints one JSON verdict. A crash (selector throws on load)
        # is also exit 1 and has no verdict: that is "could not check", never a silent pass.
        __oc_crashed=0
        if [ "$__oc_rc" -eq 1 ] && ! grep -q '"verdict"' "$__oc_out" 2>/dev/null; then
          __oc_crashed=1
        fi
        if [ "$__oc_crashed" -eq 1 ]; then
          printf 'outcome gate: WARNING could not check (exit %s) - NOT enforced\n' "$__oc_rc" >&2
          cat "$__oc_err" >&2
        elif [ "$__oc_rc" -eq 0 ]; then
          cat "$__oc_err" >&2
        elif [ "$__oc_rc" -eq 1 ]; then
          cat "$__oc_err" >&2
          printf 'Deliberate bypass: AUTOPILOT_QC_OUTCOME=off for this stage, or git push --no-verify\n' >&2
          if [ "$OUTCOME" = "block" ]; then
            outcome_refused=1
          else
            printf '(outcome=warn, allowing the push)\n' >&2
          fi
        else
          printf 'outcome gate: WARNING could not check (exit %s) - NOT enforced\n' "$__oc_rc" >&2
          cat "$__oc_err" >&2
        fi
        rm -f "$__oc_out" "$__oc_err"
      fi
    fi
  fi
done <<< "$__PUSH_STDIN"

if [ -z "$violations" ]; then
  if [ "$outcome_refused" -ne 0 ]; then
    exit 1
  fi
  exit 0
fi

printf '\n\033[1mqc-gate: protected-path push without review evidence\033[0m\n' >&2
printf '%b' "$violations" >&2
printf '\nProtected: %s\nEvidence required: %s (mode=%s)\n' "$PATHS_CSV" "$EVIDENCE" "$MODE" >&2
printf 'Fix: run the qc gate (quality-pipeline / reviewer), then add a trailer to the landing commit:\n' >&2
printf '     QC-Verdict: PASS (reviewer <id>, %s)\n' "$(date +%Y-%m-%d 2>/dev/null || echo YYYY-MM-DD)" >&2
printf 'Deliberate bypass (logged by git): git push --no-verify\n\n' >&2

if [ "$MODE" = "warn" ]; then
  printf '\033[33m(mode=warn — allowing the push)\033[0m\n\n' >&2
  if [ "$outcome_refused" -ne 0 ]; then
    exit 1
  fi
  exit 0
fi
exit 1
