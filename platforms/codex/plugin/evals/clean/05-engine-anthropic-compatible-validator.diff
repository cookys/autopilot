   assertOneOf(value, 'implementer_runner', ['auto', 'codex', 'agy', 'grok', 'cc-shim']);
   assertOneOf(value, 'spec_review', ['on', 'off']);
   assertOneOf(value, 'independent_harness', ['on', 'off']);
