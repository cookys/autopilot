{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/spend-history.schema.json",
  "title": "spend-history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated_at",
    "samples"
  ],
  "properties": {
    "schema": {
      "const": "autopilot.spend-history/1"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "usd"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "usd": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
