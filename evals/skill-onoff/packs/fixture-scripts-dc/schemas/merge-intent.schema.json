{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/merge-intent.schema.json",
  "title": "sealed-merge-intent",
  "description": "LSM P2 ordered merge intent. The seal binds exact refs, worktrees, pinned SHAs, modes, reverse prohibitions, and path-scoped preservation policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "seal"],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "seal": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "exactRef": {
      "type": "string",
      "pattern": "^refs/"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "repo",
        "root_run_id",
        "edges",
        "forbidden_reverse_edges",
        "preservation_policy"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "artifact_type": { "type": "string", "const": "merge_intent_manifest" },
        "repo": { "type": "string", "minLength": 1 },
        "root_run_id": { "type": "string", "minLength": 1 },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edge" }
        },
        "forbidden_reverse_edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/forbiddenEdge" }
        },
        "preservation_policy": { "$ref": "#/$defs/preservationPolicy" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "source_ref",
        "source_worktree",
        "source_sha",
        "source_from_edge",
        "target_ref",
        "target_worktree",
        "target_sha",
        "target_from_edge",
        "mode",
        "required_result"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "source_ref": { "$ref": "#/$defs/exactRef" },
        "source_worktree": { "type": "string", "pattern": "^/" },
        "source_sha": { "$ref": "#/$defs/gitOid" },
        "source_from_edge": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "target_ref": { "$ref": "#/$defs/exactRef" },
        "target_worktree": { "type": "string", "pattern": "^/" },
        "target_sha": { "$ref": "#/$defs/gitOid" },
        "target_from_edge": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "mode": { "type": "string", "enum": ["no-ff", "ff-only"] },
        "required_result": { "type": "string", "const": "source-contained" }
      }
    },
    "forbiddenEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "target_ref"],
      "properties": {
        "source_ref": { "$ref": "#/$defs/exactRef" },
        "target_ref": { "$ref": "#/$defs/exactRef" }
      }
    },
    "preservationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_path_prefixes"],
      "properties": {
        "allowed_path_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+/$"
          }
        }
      }
    }
  }
}
