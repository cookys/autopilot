{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/normalized-transcript-event.schema.json",
  "title": "NormalizedTranscriptEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness",
    "session_id",
    "timestamp",
    "event_class",
    "actor",
    "category",
    "signals",
    "tool",
    "usage",
    "cwd",
    "repo_hint",
    "control",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "harness": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_class": {
      "enum": [
        "session",
        "message",
        "tool_call",
        "tool_result",
        "usage",
        "control",
        "lifecycle",
        "state_transition"
      ]
    },
    "actor": {
      "enum": [
        "user",
        "assistant",
        "tool",
        "system",
        null
      ]
    },
    "category": {
      "enum": [
        "session_metadata",
        "user_message",
        "assistant_message",
        "tool_call",
        "tool_result",
        "provider_dispatch",
        "provider_result",
        "controller",
        "worktree_create",
        "worktree_remove",
        "state_transition",
        "usage"
      ]
    },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "transport_failure",
          "user_correction",
          "status_reversal",
          "code_ready",
          "merge_ready"
        ]
      }
    },
    "tool": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "call_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "requested",
            "success",
            "failed",
            "unknown"
          ]
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "control": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "dispatch_kind",
        "provider",
        "ticket_fingerprint",
        "generation",
        "lifecycle_fingerprint",
        "state",
        "owned"
      ],
      "properties": {
        "dispatch_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "ticket_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "lifecycle_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "code_ready",
            "merge_ready",
            null
          ]
        },
        "owned": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "timestamp",
        "event_class",
        "line"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_class": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
