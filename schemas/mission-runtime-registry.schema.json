{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/mission-runtime-registry.schema.json",
  "title": "MissionRuntimeRegistry",
  "description": "Canonical per-repository Mission registry stored under the Git common directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "repo_identity", "missions"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "artifact_type": { "type": "string", "const": "mission_runtime_registry" },
    "repo_identity": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "missions": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9a-f]{64}$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "adoption_key",
        "repo_identity",
        "mission_lineage_id",
        "task_authority_id",
        "policy_hash",
        "intent_hash",
        "initial_required_acceptance_hashes",
        "mission_policy_digest",
        "mission_graph_digest",
        "enforcement_mode",
        "prepared_state_hash",
        "state_ref"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "adoption_key": { "$ref": "#/$defs/sha256" },
        "repo_identity": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mission_lineage_id": {
          "type": "string",
          "pattern": "^lineage-v1-[0-9a-f]{64}$"
        },
        "task_authority_id": { "$ref": "#/$defs/sha256" },
        "policy_hash": { "$ref": "#/$defs/sha256" },
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "initial_required_acceptance_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "mission_policy_digest": { "$ref": "#/$defs/sha256" },
        "mission_graph_digest": { "$ref": "#/$defs/sha256" },
        "enforcement_mode": { "type": "string", "enum": ["shadow", "enforce"] },
        "prepared_state_hash": { "$ref": "#/$defs/sha256" },
        "state_ref": {
          "type": "string",
          "pattern": "^states/[0-9a-f]{64}\\.json$"
        }
      }
    }
  }
}
