#!/usr/bin/env bash
# autopilot pre-commit gate.
#
# Activated by:  scripts/install-hooks.sh  (sets core.hooksPath=.githooks)
#
# Two parts:
#   1. blind-dispatch.md issue-ref anti-rot grep (bespoke provenance guard, always).
#   1b. scripts/check-tmp-residue-registry.js --staged (temp-prefix registry gate; staged shipped
#      files + registry/reaper parity).
#   1c. scripts/leak-guard.js --staged (personal data in added lines: paths, hosts, private IPs,
#      credentials, .env files; per-file exemptions only, scripts/leak-guard-registry.json).
#   2. scripts/sync-all.sh --check --changed — the manifest-driven sync/check rituals
#      (version mirrors, agent-bodies, model-routing, codex + opencode payloads, README
#      parity, hook inventory, canonical invariants, CLAUDE.md inventory). --changed
#      scopes each ritual to the staged diff via its manifest triggers, so the common
#      commit stays fast. A new ritual is registered once in scripts/sync-manifest.json;
#      this hook never needs another hand-copied block.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- test-identity gate (KR4 / G8); first, before slower checks ---
__TIG_LIB="$(git rev-parse --show-toplevel)/.githooks/lib/test-identity-gate.sh"
if [ -r "$__TIG_LIB" ]; then
  # shellcheck disable=SC1090
  . "$__TIG_LIB"
  if ! test_identity_gate_bypassed; then
    test_identity_refuse_commit_idents || exit 1
  fi
fi
unset __TIG_LIB

# --- blind-dispatch.md issue-ref anti-rot grep (always) ---
# The "Clarifying questions survive auto-approve" subsection cites the two codex
# issues that establish the auto-approve-vs-question distinction. If a reword
# drops them, the claim loses its provenance. Keep this assertion in lockstep
# with that subsection.
if ! grep -q 'issues/10187' references/blind-dispatch.md || ! grep -q 'issues/2138' references/blind-dispatch.md; then
  echo "pre-commit: references/blind-dispatch.md lost a required issue ref (#10187 and/or #2138)" >&2
  exit 1
fi

# --- tmp-residue gate: an unregistered temp reference cannot ship ---
# Scans only the staged shipped files (src/ bin/ hooks/ scripts/, never tests) for temp-root
# references that are neither registered in scripts/lib/tmp-residue-registry.json, cleaned by
# construction, nor allowlisted with a reason; the registry/reaper parity check always runs.
if ! TMP_GATE_OUT="$(node scripts/check-tmp-residue-registry.js --staged 2>&1)"; then
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "pre-commit: tmp-residue gate failed (unregistered temp reference)" >&2
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "$TMP_GATE_OUT" >&2
  exit 1
fi

# --- leak-guard: no personal data in the lines this commit adds ---
# Added lines only (renames detected), so history is never re-judged. A missing or broken
# registry fails the gate. The failure text carries a runnable redaction command.
if ! LEAK_OUT="$(node scripts/leak-guard.js --staged 2>&1)"; then
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "pre-commit: leak-guard failed (personal data in added lines)" >&2
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "$LEAK_OUT" >&2
  exit 1
fi

# --- manifest-driven sync/check rituals, scoped to the staged diff ---
if ! SYNC_OUT="$(bash scripts/sync-all.sh --check --changed 2>&1)"; then
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "pre-commit: sync/check ritual drift detected" >&2
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "$SYNC_OUT" >&2
  echo "" >&2
  echo "Each failing ritual above names its fix command. After fixing, re-stage and re-commit." >&2
  exit 1
fi
