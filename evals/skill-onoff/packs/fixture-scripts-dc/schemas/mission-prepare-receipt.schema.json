{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/mission-prepare-receipt.schema.json",
  "title": "MissionPrepareReceipt",
  "description": "Content-bound projection of one Mission entry in the canonical Git common-dir registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "repo_identity",
    "adoption_key",
    "mission_lineage_id",
    "task_authority_id",
    "policy_hash",
    "intent_hash",
    "initial_required_acceptance_hashes",
    "mission_policy_digest",
    "mission_graph_digest",
    "enforcement_mode",
    "state_hash",
    "adopted",
    "prepared_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "artifact_type": { "type": "string", "const": "mission_prepare_receipt" },
    "repo_identity": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "adoption_key": { "$ref": "#/$defs/sha256" },
    "mission_lineage_id": {
      "type": "string",
      "pattern": "^lineage-v1-[0-9a-f]{64}$"
    },
    "task_authority_id": { "$ref": "#/$defs/sha256" },
    "policy_hash": { "$ref": "#/$defs/sha256" },
    "intent_hash": { "$ref": "#/$defs/sha256" },
    "initial_required_acceptance_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "mission_policy_digest": { "$ref": "#/$defs/sha256" },
    "mission_graph_digest": { "$ref": "#/$defs/sha256" },
    "enforcement_mode": { "type": "string", "enum": ["shadow", "enforce"] },
    "state_hash": { "$ref": "#/$defs/sha256" },
    "adopted": { "type": "boolean" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "receipt_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
