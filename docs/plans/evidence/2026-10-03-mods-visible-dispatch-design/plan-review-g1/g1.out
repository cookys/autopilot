    },
    {
      "rubric_id": "R5",
      "class": "future",
      "severity": "non-blocking",
      "affected_surface": "review page relative asset URLs under /<date>/<job>/current/",
      "claim": "Because pages are served via the current symlink and reference assets relatively, a browser that loaded the old index.html and fetches assets after a switch resolves them in the new version directory; content-hashed names make this safe only while the asset still exists in the new version, otherwise the old page shows a broken image during that window.",
      "evidence": "P1b: URL fixed at /<date>/<job>/current/index.html; bundle copies assets to <job>/assets/<sha256 前 12>.<ext> per version; previous version retained one generation but not reachable through current.",
      "evidence_reference": "plan section 4 P1b bundle paragraph and 發佈 paragraph",
      "repair": "No current change; follow-up only. If this is observed, link assets by version path (../v-<ts>/assets/...) or keep assets in a shared per-job assets/ pool reaped with the version directories.",
      "blocks_next_slice_or_immediate_integrity": false,
