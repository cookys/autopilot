.DS_Store
*.swp
*~
node_modules/
.claude/session-start-sha
# .claude/knowledge/ is ignored ON PURPOSE (fail-closed): this repo is PUBLIC, and the
# .claude dir is local state, so nothing lands here by accident. A knowledge file becomes
# real only via the promotion contract, which is deliberately NOT one motion: git add -f
# and show the diff, then STOP for an explicit human approval, and only then commit.
# 不 commit 就等於沒寫: an uncommitted file here is invisible to git status, to every
# clone, and to CI. The contract and the disclosure line are canonical in
# references/knowledge-routing.md — this comment is a pointer, not a second authority.
.claude/knowledge/
.claude/settings.local.json
.claude/next-state.json
.claude/agents/
.claude/worktrees/
.context/
.in_use/
hooks/hooks.json.capture-backup
# Dated eval result dirs that are noise — non-baseline runs.
# Baseline runs (2026-05-14_122359 + _155325) are explicitly tracked.
skill-creator-workspace/results/*/2026-05-14_154034/
# Task-tree engine: index.json is derived from events.jsonl and must not be
# tracked. index.* also covers the same-dir mktemp temp file (index.XXXXXX)
# that an interrupted rebuild could leave behind. ** (not *) so archived
# projects under _archive/<proj>/ stay covered too.
docs/projects/**/tree/index.*
# Ephemeral flock sidecar created by tree.sh locked_append.
docs/projects/**/tree/events.jsonl.lock
# QC-panel raw judge transcripts (tree/panel/<node>-<ts>-[ab]_q<n>.txt) are
# tertiary work product — the manager isn't even meant to read them directly
# (KR1). Only the per-run verdict JSON + the calibration sample carry the
# auditable signal, and those stay tracked. ** so _archive/<proj>/ is covered.
docs/projects/**/tree/panel/*_q[0-9].txt
__pycache__/

# worktree-orphan marker (never shipped)
.orphaned_at
eval-repo-*/
orch-eval-scratch-home-*/
# .claude/settings.json is TRACKED since v2.34.23 (carries the CLAUDE_CODE_ENABLE_TODO_TOOLS
# env pin that keeps dev-flow forcing functions alive on 5-era models — worktree foremen need
# it in their checkout). Personal overrides go in .claude/settings.local.json (ignored below).

# transient orchestration calibration run outputs (depth-0 runs these)
docs/projects/_archive/2026-07-09-m3-band-tasks/runs/

# codeforge local capture (signals/L1 store) — local knowledge, not versioned
.codeforge/
