{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/task-authority-envelope.schema.json",
  "title": "TaskAuthorityEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_authority_id",
    "task_id",
    "policy_hash",
    "authority_status",
    "intent",
    "acceptance",
    "red_lines",
    "effect_permissions",
    "resource_ceiling",
    "data_egress_policy",
    "escalation_policy",
    "finish_receipt_schema",
    "execution_preferences"
  ],
  "optional_provenance": [
    "mission_lineage_id",
    "mission_policy_digest",
    "mission_graph_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_authority_id": { "$ref": "#/$defs/sha256" },
    "task_id": { "$ref": "#/$defs/token" },
    "policy_hash": { "$ref": "#/$defs/sha256" },
    "authority_status": { "const": "shadow" },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "requirements_hash", "scope"],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "requirements_hash": { "$ref": "#/$defs/sha256" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_classes", "domains", "languages", "allowed_tools", "artifact_roots"],
          "properties": {
            "task_classes": { "$ref": "#/$defs/non_empty_tokens" },
            "domains": { "$ref": "#/$defs/non_empty_tokens" },
            "languages": { "$ref": "#/$defs/non_empty_tokens" },
            "allowed_tools": { "$ref": "#/$defs/tokens" },
            "artifact_roots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/relative_path" }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_hash", "criteria_hash", "required_evidence"],
      "properties": {
        "contract_hash": { "$ref": "#/$defs/sha256" },
        "criteria_hash": { "$ref": "#/$defs/sha256" },
        "required_evidence": { "$ref": "#/$defs/non_empty_tokens" }
      }
    },
    "red_lines": { "$ref": "#/$defs/tokens" },
    "effect_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects"],
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "tool_class",
              "action_class",
              "roles",
              "destinations",
              "requires_approval",
              "max_uses",
              "requires_mediator",
              "requires_challenge"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/token" },
              "operation": { "$ref": "#/$defs/token" },
              "tool_class": { "$ref": "#/$defs/token" },
              "action_class": {
                "enum": ["read_only", "reversible", "external", "irreversible"]
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/role" }
              },
              "destinations": { "$ref": "#/$defs/non_empty_tokens" },
              "requires_approval": { "type": "boolean" },
              "max_uses": { "type": "integer", "minimum": 1 },
              "requires_mediator": { "type": "boolean" },
              "requires_challenge": { "type": "boolean" }
            }
          }
        }
      }
    },
    "resource_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "max_wall_seconds",
        "max_tool_calls",
        "max_cost_usd_micros",
        "max_grant_ttl_seconds"
      ],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_wall_seconds": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_cost_usd_micros": { "type": "integer", "minimum": 0 },
        "max_grant_ttl_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "data_egress_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rules"],
      "properties": {
        "mode": { "enum": ["local-only", "allowlisted", "online"] },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/egress_rule" }
        }
      }
    },
    "escalation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_role_denied",
        "on_scope_mismatch",
        "protected_effects_require_escalation"
      ],
      "properties": {
        "on_role_denied": { "enum": ["block", "escalate"] },
        "on_scope_mismatch": { "enum": ["block", "escalate"] },
        "protected_effects_require_escalation": { "type": "boolean" }
      }
    },
    "finish_receipt_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "required_fields"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/token" },
        "required_fields": { "$ref": "#/$defs/non_empty_tokens" }
      }
    },
    "execution_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guidance_profile",
        "guidance_source",
        "assurance_profile",
        "assurance_source",
        "topology_preference",
        "topology_source",
        "data_egress",
        "data_egress_source"
      ],
      "properties": {
        "guidance_profile": { "enum": ["adaptive", "guided", "autonomous"] },
        "guidance_source": { "enum": ["project-default", "task-override"] },
        "assurance_profile": { "enum": ["standard", "conservative"] },
        "assurance_source": { "enum": ["project-default", "task-override"] },
        "topology_preference": { "enum": ["auto", "inline", "foreman", "heterogeneous"] },
        "topology_source": { "enum": ["project-default", "task-override"] },
        "data_egress": { "enum": ["local-only", "allowlisted", "online"] },
        "data_egress_source": { "enum": ["project-default", "task-override"] }
      }
    },
    "mission_lineage_id": {
      "type": "string",
      "pattern": "^lineage-v1-[0-9a-f]{64}$"
    },
    "mission_policy_digest": { "$ref": "#/$defs/sha256" },
    "mission_graph_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "non_empty_tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*\\\\]).+"
    },
    "role": {
      "enum": ["owner", "implementer", "reviewer", "verification_author", "explorer"]
    },
    "egress_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_class",
        "route_class",
        "destination",
        "transport",
        "effect",
        "max_payload_classification"
      ],
      "properties": {
        "data_class": {
          "enum": [
            "task_prompt",
            "source",
            "diff",
            "artifact",
            "test_log",
            "telemetry_metadata",
            "benchmark_metadata"
          ]
        },
        "route_class": {
          "enum": ["runner", "reviewer", "tool", "telemetry", "benchmark_refresh"]
        },
        "destination": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "transport": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "effect": { "enum": ["allow", "deny"] },
        "max_payload_classification": {
          "enum": ["public", "metadata", "task", "source", "sensitive"]
        }
      }
    }
  }
}
