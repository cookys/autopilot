{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/owner-event.schema.json",
  "title": "OwnerKernelEvent",
  "description": "Structural schema for a witnessed Owner Kernel event. State-dependent authorization is enforced by src/engine/owner-kernel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "run_id",
    "type",
    "emitted_at",
    "emitter",
    "policy_hash",
    "contract_hash",
    "payload",
    "prev_event_hash",
    "content_hash",
    "event_hash",
    "witness"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "type": {
      "type": "string",
      "enum": [
        "intent",
        "approval",
        "abort",
        "decision",
        "evidence",
        "checkpoint",
        "acceptance_attempt",
        "acceptance_resolution",
        "acceptance",
        "complete",
        "terminal_control",
        "abort_request",
        "delegation",
        "recovery",
        "suspension",
        "principal_change",
        "translation_used",
        "task_authority_frozen",
        "role_grant_issued",
        "role_grant_revoked"
      ]
    },
    "emitted_at": { "type": "string", "format": "date-time" },
    "emitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "channel"],
      "properties": {
        "kind": { "type": "string", "enum": ["user", "owner", "kernel", "runner", "challenger", "translation"] },
        "identity": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 }
      }
    },
    "policy_hash": { "$ref": "#/$defs/sha256" },
    "contract_hash": { "$ref": "#/$defs/sha256" },
    "authority_hash": { "$ref": "#/$defs/sha256" },
    "acceptance_authority_hash": { "$ref": "#/$defs/sha256" },
    "semantic_authority_hash": { "$ref": "#/$defs/sha256" },
    "payload": { "type": "object" },
    "prev_event_hash": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "content_hash": { "$ref": "#/$defs/sha256" },
    "event_hash": { "$ref": "#/$defs/sha256" },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "stream_id",
        "sequence",
        "event_hash",
        "previous_witness_head",
        "witness_head"
      ],
      "properties": {
        "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "stream_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "event_hash": { "$ref": "#/$defs/sha256" },
        "previous_witness_head": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "witness_head": { "$ref": "#/$defs/sha256" },
        "batch_id": { "type": "string", "minLength": 1 },
        "batch_index": { "type": "integer", "minimum": 0 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "batch_event_hashes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "batch_commitment": { "$ref": "#/$defs/sha256" },
        "coordinator_commitment": { "type": "object" },
        "semantic_route_hash": { "$ref": "#/$defs/sha256" },
        "durable_request_hash": { "$ref": "#/$defs/sha256" },
        "durable_event_payload_hash": { "$ref": "#/$defs/sha256" },
        "receipt_anchor_hash": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "semantic_route_hash": ["durable_request_hash", "durable_event_payload_hash", "receipt_anchor_hash"],
        "durable_request_hash": ["semantic_route_hash", "durable_event_payload_hash", "receipt_anchor_hash"],
        "durable_event_payload_hash": ["semantic_route_hash", "durable_request_hash", "receipt_anchor_hash"],
        "receipt_anchor_hash": ["semantic_route_hash", "durable_request_hash", "durable_event_payload_hash"]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["intent", "approval", "abort_request"] } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "user" } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "decision" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "owner" } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "evidence" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "enum": ["kernel", "runner", "challenger"] } } } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["checkpoint", "acceptance"] } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "enum": ["kernel", "runner"] } } } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["acceptance_attempt", "acceptance_resolution"] } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "kernel" } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "complete" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "kernel" } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "terminal_control" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "user" } } } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["suspension", "principal_change"] } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "kernel" } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "task_authority_frozen" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": {
        "kind": { "const": "kernel" },
        "identity": { "const": "owner-kernel" },
        "channel": { "const": "kernel-task-authority" }
      } } } }
    },
    {
      "if": { "properties": { "type": { "const": "role_grant_issued" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": {
        "kind": { "const": "kernel" },
        "identity": { "const": "owner-kernel" },
        "channel": { "pattern": "^kernel-role-grant:.+$" }
      } } } }
    },
    {
      "if": { "properties": { "type": { "const": "role_grant_revoked" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": {
        "kind": { "const": "kernel" },
        "identity": { "const": "owner-kernel" },
        "channel": { "pattern": "^kernel-role-grant-(?:revocation|observer:.+)$" }
      } } } }
    },
    {
      "if": { "properties": { "type": { "const": "translation_used" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "translation" } } } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["delegation", "recovery"] } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "const": "owner" } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "abort" } }, "required": ["type"] },
      "then": { "properties": { "emitter": { "properties": { "kind": { "enum": ["user", "kernel"] } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}
