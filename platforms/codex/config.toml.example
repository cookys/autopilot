# Codex (OpenAI) configuration example for using Autopilot skills.
#
# Place at: ~/.codex/config.toml (or merge into existing file)
# verified-against: codex-cli 0.142.5 local plugin CLI (2026-07-01)
#
# Codex scans for skills in this order (from cwd up to /):
#   1. <repo>/.agents/skills/         (covered by autopilot's .agents/skills/ → ../skills symlink)
#   2. ~/.agents/skills/              (global; uncomment skills.config entry below to point here)
#   3. /etc/codex/skills/             (system-wide)
#   4. bundled                        (built-in)
#
# Autopilot's .agents/skills/ symlink (auto-created by scripts/setup-symlinks.sh)
# is sufficient for per-repo Codex usage — no config.toml change required.
#
# Autopilot also ships a Codex plugin package with skills plus one production
# PostCompact recovery hook under platforms/codex/plugin, with a repo-local
# marketplace under platforms/codex/. This does not imply Claude hook parity.
# Install it with:
#
#   ./scripts/sync-codex-plugin-skills.sh
#   codex plugin marketplace add ./platforms/codex
#   codex plugin add autopilot@autopilot-local
#
# Only use this config file if you want Autopilot skills globally available across
# repos without symlinking each one.

# Optional: enable a custom skill path (requires Codex with [skills.config] support).
# [[skills.config]]
# path = "~/.agents/skills"
# enabled = true

# CODEX_HOME defaults to ~/.codex; this file lives there.
# No CODEX_PLUGIN_ROOT exists — that env var is fictional (see Autopilot's
# references/multi-agent-portability.md "Things NOT verified" section).
