{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/events.schema.json",
  "title": "autopilot-events",
  "oneOf": [
    {
      "$ref": "#/$defs/envelope"
    },
    {
      "$ref": "#/$defs/error_object"
    }
  ],
  "$defs": {
    "hex12": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "project_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "data_dispatch_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "role",
        "runner",
        "model",
        "branch",
        "base_sha"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "parent_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "timeout_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "event_dispatch_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dispatch\\.started:.+$"
        },
        "kind": {
          "const": "dispatch.started"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "dispatch_manifest"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_dispatch_started"
        }
      }
    },
    "data_dispatch_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "final_status",
        "duration_s",
        "role",
        "runner",
        "model"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "final_status": {
          "type": "string"
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "event_dispatch_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dispatch\\.ended:.+$"
        },
        "kind": {
          "const": "dispatch.ended"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "dispatch_manifest"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_dispatch_ended"
        }
      }
    },
    "data_cost_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "model",
        "tier",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "cost_usd",
        "sidechain"
      ],
      "properties": {
        "session": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "sidechain": {
          "type": "boolean"
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event_cost_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cost\\.turn:.+$"
        },
        "kind": {
          "const": "cost.turn"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "costs"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_cost_turn"
        }
      }
    },
    "data_review_collected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "phase_base12",
        "generation",
        "base",
        "head",
        "seats",
        "reviewed_seats",
        "total_seats"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "phase_base12": {
          "$ref": "#/$defs/hex12"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "reviewed_seats": {
          "type": "integer",
          "minimum": 0
        },
        "total_seats": {
          "type": "integer",
          "minimum": 0
        },
        "findings_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "title": "optional: absent when g<N>/findings.json is missing (the event is kept, warning findings_missing)"
        },
        "findings_by_severity": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "event_review_collected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^review\\.collected:.+$"
        },
        "kind": {
          "const": "review.collected"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "review_ledger"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_review_collected"
        }
      }
    },
    "data_review_finalized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "phase_base12",
        "generation",
        "reviewed_seats",
        "total_seats",
        "dispositions_sha256"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "phase_base12": {
          "$ref": "#/$defs/hex12"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "open_findings": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reviewed_seats": {
          "type": "integer",
          "minimum": 0
        },
        "total_seats": {
          "type": "integer",
          "minimum": 0
        },
        "dispositions_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "event_review_finalized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^review\\.finalized:.+$"
        },
        "kind": {
          "const": "review.finalized"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "review_ledger"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_review_finalized"
        }
      }
    },
    "data_qc_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "verdict",
        "subject",
        "basis"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "verdict": {
          "type": "string",
          "maxLength": 64
        },
        "subject": {
          "type": "string",
          "maxLength": 120
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "event_qc_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^qc\\.verdict:.+$"
        },
        "kind": {
          "const": "qc.verdict"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "git_trailer"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_qc_verdict"
        }
      }
    },
    "data_decision_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "row_kind"
      ],
      "properties": {
        "basis": {
          "type": "string"
        },
        "row_kind": {
          "type": "string"
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "round": {
          "type": [
            "integer",
            "null"
          ]
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "reversibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "target_decision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rung": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event_decision_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^decision\\.row:.+$"
        },
        "kind": {
          "const": "decision.row"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "decision_ledger"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_decision_row"
        }
      }
    },
    "data_run_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "stage",
        "generation",
        "basis"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "title": "status = row.status when the row has a status property (even an empty string), else row.state; both properties present with different values: status wins and the reader warns status_state_conflict"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "event_run_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run\\.stage:.+$"
        },
        "kind": {
          "const": "run.stage"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "const": "run_ledger"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/data_run_stage"
        }
      }
    },
    "event_unknown_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "ts_basis",
        "source",
        "project_key",
        "root_run_id",
        "run_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "type": "string",
          "pattern": "^(?!(?:dispatch\\.started|dispatch\\.ended|cost\\.turn|review\\.collected|review\\.finalized|qc\\.verdict|decision\\.row|run\\.stage)$).+$"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_basis": {
          "enum": [
            "source",
            "mtime"
          ]
        },
        "source": {
          "type": "string"
        },
        "project_key": {
          "$ref": "#/$defs/project_key"
        },
        "root_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object"
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/event_dispatch_started"
        },
        {
          "$ref": "#/$defs/event_dispatch_ended"
        },
        {
          "$ref": "#/$defs/event_cost_turn"
        },
        {
          "$ref": "#/$defs/event_review_collected"
        },
        {
          "$ref": "#/$defs/event_review_finalized"
        },
        {
          "$ref": "#/$defs/event_qc_verdict"
        },
        {
          "$ref": "#/$defs/event_decision_row"
        },
        {
          "$ref": "#/$defs/event_run_stage"
        },
        {
          "$ref": "#/$defs/event_unknown_kind"
        }
      ]
    },
    "source_stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "rows_read",
        "rows_skipped",
        "rows_filtered",
        "redactions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ok",
            "absent",
            "degraded"
          ]
        },
        "rows_read": {
          "type": "integer",
          "minimum": 0
        },
        "rows_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "rows_filtered": {
          "type": "integer",
          "minimum": 0
        },
        "redactions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "code",
        "detail",
        "count"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generated_at",
        "project",
        "events",
        "cursor",
        "has_more",
        "sources",
        "warnings"
      ],
      "properties": {
        "schema": {
          "const": "autopilot.events/1"
        },
        "generated_at": {
          "$ref": "#/$defs/ts"
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_key",
            "repo_name"
          ],
          "properties": {
            "project_key": {
              "$ref": "#/$defs/project_key"
            },
            "repo_name": {
              "type": "string"
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "cursor": {
          "type": "string"
        },
        "has_more": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_stat"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "error_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "autopilot.events/1"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
