{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autopilot.dev/schemas/review-loop-contract.schema.json",
  "title": "resolve-review-loop contract",
  "description": "Single source of truth for the always-emitted review-loop resolver contract. Every field here is emitted by scripts/resolve-review-loop.sh on a default run AND validated by src/engine/resolve-review-loop.js. src/engine/resolve-review-loop.js DERIVES its REVIEW_LOOP_FIELDS list and its assertOneOf enum tables from this document — do not hand-maintain a second copy. scripts/check-contract-schema.js gates the shell side against it. Conditional/optional keys (reviewer_qualified, fallback_ladder, verify_first, capability_tier, density_scaled, density_source) are emitted only under specific flags and are NOT part of this always-on contract; they are handled separately in the JS validator. x-field-order fixes the canonical REVIEW_LOOP_FIELDS ordering. x-shell-validated marks the enum fields whose allowed-value set the shell resolver enforces via a case statement; x-shell-var names the shell variable whose case arm enforces it (check-contract-schema.js reconciles the per-field arm).",
  "type": "object",
  "x-field-order": [
    "reviewer_engine",
    "reviewer_effort",
    "reviewer_runner",
    "implementer_engine",
    "implementer_effort",
    "implementer_runner",
    "loop_max_rounds",
    "loop_convergence_verdict",
    "spec_review",
    "independent_harness",
    "qc_panel",
    "qc_panel_aggregation",
    "review_risk",
    "required_review_families",
    "l1_required",
    "cross_family_required",
    "cross_family_satisfied",
    "review_diff_scope",
    "source",
    "work_domain",
    "domain_source",
    "capability_state_source",
    "quota_status",
    "quota_reset_at",
    "skill_mode_requested",
    "skill_mode_effective",
    "capability_warnings",
    "reviewer_endpoint",
    "reviewer_family",
    "implementer_endpoint",
    "verification_author_present",
    "verification_author_engine",
    "verification_author_runner",
    "verification_author_effort",
    "verification_author_endpoint",
    "verification_author_family",
    "implementer_family",
    "config_path",
    "min_panel_size",
    "on_engine_unavailable",
    "reviewer_engine_low_risk",
    "reviewer_effort_low_risk",
    "on_family_conflict",
    "reviewer_fallback_preference",
    "reviewer_fallback_preference_low_risk",
    "qc_panel_seats",
    "qc_panel_seats_complete",
    "provider_readiness_receipt_ttl_seconds",
    "provider_readiness_fallback_family_constraint",
    "plan_review",
    "plan_reviewer_engine",
    "plan_reviewer_effort",
    "plan_reviewer_runner",
    "plan_reviewer_endpoint",
    "plan_deep_reviewer_engine",
    "plan_deep_reviewer_effort",
    "plan_deep_reviewer_runner",
    "plan_deep_reviewer_endpoint",
    "plan_review_max_generations",
    "plan_review_max_wall_seconds",
    "plan_review_growth_warn_ratio",
    "plan_review_growth_stop_ratio"
  ],
  "properties": {
    "reviewer_engine": { "type": "string", "minLength": 1 },
    "reviewer_effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"], "x-shell-validated": true, "x-shell-var": "REV_EFFORT" },
    "reviewer_runner": { "type": "string", "enum": ["codex", "auto", "agy", "grok", "cc-shim", "anthropic-compatible", "claude-native", "qoderclicn"], "x-shell-validated": true, "x-shell-var": "REV_RUNNER" },
    "implementer_engine": { "type": "string", "minLength": 1 },
    "implementer_effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"], "x-shell-validated": true, "x-shell-var": "IMPL_EFFORT" },
    "implementer_runner": { "type": "string", "enum": ["auto", "codex", "agy", "grok", "cc-shim", "pi", "qoderclicn"], "x-shell-validated": true, "x-shell-var": "IMPL_RUNNER" },
    "loop_max_rounds": { "type": "integer" },
    "loop_convergence_verdict": { "type": "string", "minLength": 1 },
    "spec_review": { "type": "string", "enum": ["on", "off"], "x-shell-validated": true, "x-shell-var": "SPEC_REVIEW" },
    "independent_harness": { "type": "string", "enum": ["on", "off"], "x-shell-validated": true, "x-shell-var": "HARNESS" },
    "qc_panel": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "qc_panel_aggregation": { "type": "string", "enum": ["union-on-verified-critical", "unanimous-ship"], "x-shell-validated": true, "x-shell-var": "QC_AGG" },
    "review_risk": { "type": "string", "enum": ["low", "high"] },
    "required_review_families": { "type": "integer" },
    "l1_required": { "type": "boolean" },
    "cross_family_required": { "type": "boolean" },
    "cross_family_satisfied": { "type": "boolean" },
    "review_diff_scope": { "type": "string", "enum": ["full", "incremental-mitigated"], "x-shell-validated": true, "x-shell-var": "DIFF_SCOPE" },
    "source": { "type": "string", "minLength": 1 },
    "work_domain": { "type": "string", "enum": ["rust", "backend-cli", "frontend", "docs", "mixed"], "x-shell-validated": true, "x-shell-var": "DOMAIN_OVERRIDE" },
    "domain_source": { "type": "string", "enum": ["none", "explicit", "auto"] },
    "capability_state_source": { "type": "string", "minLength": 1 },
    "quota_status": { "type": "string", "minLength": 1 },
    "quota_reset_at": { "type": ["string", "null"] },
    "skill_mode_requested": { "type": "string", "minLength": 1 },
    "skill_mode_effective": { "type": "string", "minLength": 1 },
    "capability_warnings": { "type": "array", "items": { "type": "string" } },
    "reviewer_endpoint": { "type": "string" },
    "reviewer_family": { "type": "string", "minLength": 1 },
    "implementer_endpoint": { "type": "string" },
    "verification_author_present": { "type": "boolean", "enum": [true, false], "x-shell-validated": true, "x-shell-var": "VER_AUTH_PRESENT" },
    "verification_author_engine": { "type": "string" },
    "verification_author_runner": { "type": "string", "enum": ["", "codex", "agy", "grok", "cc-shim", "anthropic-compatible", "qoderclicn"] },
    "verification_author_effort": { "type": "string", "enum": ["", "low", "medium", "high", "xhigh", "max"] },
    "verification_author_endpoint": { "type": "string", "pattern": "^[A-Za-z0-9_]*$" },
    "verification_author_family": { "type": "string" },
    "implementer_family": { "type": "string" },
    "config_path": { "type": "string" },
    "min_panel_size": { "type": "integer", "minimum": 1 },
    "on_engine_unavailable": { "type": "string", "enum": ["ask", "solo-fallback", "wait-reset"], "x-shell-validated": true, "x-shell-var": "ON_ENGINE_UNAVAILABLE" },
    "reviewer_engine_low_risk": { "type": "string", "description": "Risk-tiered overlay: non-empty (with reviewer_effort_low_risk) = the LOOP reviewer engine for computed review_risk=low; empty = tiering off (reviewer_engine used at every risk). High risk always uses reviewer_engine." },
    "reviewer_effort_low_risk": { "type": "string", "description": "Effort for reviewer_engine_low_risk: empty or low|medium|high|xhigh|max. Shell coerces garbage to empty (tiering off — fail-safe reviews with the stronger incumbent). Deliberately NOT x-shell-validated: the parity gate models exact-set enums, and this field's set includes the empty string." },
    "on_family_conflict": { "type": "string", "enum": ["fallback", "block"], "x-shell-validated": true, "x-shell-var": "ON_FAMILY_CONFLICT", "description": "Engine reviewDiff policy when the (effective) reviewer shares the implementer's model family: fallback = substitute the first cross-family qualified row from fallback_ladder (runner-allowlisted, fail-closed on no candidate); block = hard-block (pre-v2.32.25 behavior). Resolver coerces garbage to block; the engine treats absent/invalid as block. The conditional --check-scorecard key fallback_ladder_implementer_family carries ladder provenance (the implementer family the ladder was computed against) so a stale pre-resolved roster fails closed." },
    "reviewer_fallback_preference": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "HUMAN-ordered engine ids the engine's family-conflict fallback prefers over raw ladder order; every candidate still passes all fallback guards. Empty = ladder order." },
    "reviewer_fallback_preference_low_risk": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Preference list applied when computed review_risk=low; empty = use reviewer_fallback_preference." },
    "qc_panel_seats": {
      "type": "array",
      "description": "Exact readiness identity for every QC seat. Empty with qc_panel_seats_complete=false means the legacy model-only panel lacks enough metadata; consumers must fail closed rather than guess.",
      "items": {
        "type": "object",
        "required": ["role", "runner", "model", "effort", "endpoint", "family"],
        "properties": {
          "role": { "type": "string", "enum": ["qc"] },
          "runner": { "type": "string", "enum": ["codex", "agy", "grok", "cc-shim", "anthropic-compatible", "claude-native", "qoderclicn"] },
          "model": { "type": "string", "minLength": 1 },
          "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] },
          "endpoint": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[A-Za-z0-9_]+$" }
            ]
          },
          "family": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "qc_panel_seats_complete": { "type": "boolean" },
    "provider_readiness_receipt_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "provider_readiness_fallback_family_constraint": { "type": "string", "enum": ["any", "different"], "x-shell-validated": true, "x-shell-var": "PROVIDER_READINESS_FAMILY_CONSTRAINT" },
    "plan_review": { "type": "string", "enum": ["on", "off"], "x-shell-validated": true, "x-shell-var": "PLAN_REVIEW", "description": "Enable the first-class bounded plan-readiness rail. Independent from the deprecated spec_review implementation-loop switch." },
    "plan_reviewer_engine": { "type": "string" },
    "plan_reviewer_effort": { "type": "string", "enum": ["", "low", "medium", "high", "xhigh", "max"] },
    "plan_reviewer_runner": { "type": "string", "enum": ["", "codex", "agy", "grok", "cc-shim", "anthropic-compatible", "claude-native", "qoderclicn"] },
    "plan_reviewer_endpoint": { "type": "string", "pattern": "^[A-Za-z0-9_]*$" },
    "plan_deep_reviewer_engine": { "type": "string" },
    "plan_deep_reviewer_effort": { "type": "string", "enum": ["", "low", "medium", "high", "xhigh", "max"] },
    "plan_deep_reviewer_runner": { "type": "string", "enum": ["", "codex", "agy", "grok", "cc-shim", "anthropic-compatible", "claude-native", "qoderclicn"] },
    "plan_deep_reviewer_endpoint": { "type": "string", "pattern": "^[A-Za-z0-9_]*$" },
    "plan_review_max_generations": { "type": "integer", "minimum": 1, "maximum": 2 },
    "plan_review_max_wall_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "plan_review_growth_warn_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.25 },
    "plan_review_growth_stop_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.5 }
  },
  "required": [
    "reviewer_engine",
    "reviewer_effort",
    "reviewer_runner",
    "implementer_engine",
    "implementer_effort",
    "implementer_runner",
    "loop_max_rounds",
    "loop_convergence_verdict",
    "spec_review",
    "independent_harness",
    "qc_panel",
    "qc_panel_aggregation",
    "review_risk",
    "required_review_families",
    "l1_required",
    "cross_family_required",
    "cross_family_satisfied",
    "review_diff_scope",
    "source",
    "work_domain",
    "domain_source",
    "capability_state_source",
    "quota_status",
    "quota_reset_at",
    "skill_mode_requested",
    "skill_mode_effective",
    "capability_warnings",
    "reviewer_endpoint",
    "reviewer_family",
    "implementer_endpoint",
    "verification_author_present",
    "verification_author_engine",
    "verification_author_runner",
    "verification_author_effort",
    "verification_author_endpoint",
    "verification_author_family",
    "implementer_family",
    "config_path",
    "min_panel_size",
    "on_engine_unavailable",
    "reviewer_engine_low_risk",
    "reviewer_effort_low_risk",
    "on_family_conflict",
    "reviewer_fallback_preference",
    "reviewer_fallback_preference_low_risk",
    "qc_panel_seats",
    "qc_panel_seats_complete",
    "provider_readiness_receipt_ttl_seconds",
    "provider_readiness_fallback_family_constraint",
    "plan_review",
    "plan_reviewer_engine",
    "plan_reviewer_effort",
    "plan_reviewer_runner",
    "plan_reviewer_endpoint",
    "plan_deep_reviewer_engine",
    "plan_deep_reviewer_effort",
    "plan_deep_reviewer_runner",
    "plan_deep_reviewer_endpoint",
    "plan_review_max_generations",
    "plan_review_max_wall_seconds",
    "plan_review_growth_warn_ratio",
    "plan_review_growth_stop_ratio"
  ],
  "additionalProperties": true
}
