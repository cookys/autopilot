+    if (hashed !== entry.oid) {
+      throw new Error(`tree integrity: ${rel}`);
+    }
+  }
+  for (const item of walkLstat(treeDir)) {
+    if (!listed.has(item.rel)) {
+      throw new Error(`tree integrity: ${item.rel}`);
+    }
+  }
