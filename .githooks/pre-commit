#!/usr/bin/env bash
# autopilot pre-commit gate.
#
# Activated by:  scripts/install-hooks.sh  (sets core.hooksPath=.githooks)
#
# Two parts:
#   1. blind-dispatch.md issue-ref anti-rot grep (bespoke provenance guard, always).
#   2. scripts/sync-all.sh --check --changed — the manifest-driven sync/check rituals
#      (version mirrors, agent-bodies, model-routing, codex + opencode payloads, README
#      parity, hook inventory, canonical invariants, CLAUDE.md inventory). --changed
#      scopes each ritual to the staged diff via its manifest triggers, so the common
#      commit stays fast. A new ritual is registered once in scripts/sync-manifest.json;
#      this hook never needs another hand-copied block.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- blind-dispatch.md issue-ref anti-rot grep (always) ---
# The "Clarifying questions survive auto-approve" subsection cites the two codex
# issues that establish the auto-approve-vs-question distinction. If a reword
# drops them, the claim loses its provenance. Keep this assertion in lockstep
# with that subsection.
if ! grep -q 'issues/10187' references/blind-dispatch.md || ! grep -q 'issues/2138' references/blind-dispatch.md; then
  echo "pre-commit: references/blind-dispatch.md lost a required issue ref (#10187 and/or #2138)" >&2
  exit 1
fi

# --- manifest-driven sync/check rituals, scoped to the staged diff ---
if ! SYNC_OUT="$(bash scripts/sync-all.sh --check --changed 2>&1)"; then
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "pre-commit: sync/check ritual drift detected" >&2
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "$SYNC_OUT" >&2
  echo "" >&2
  echo "Each failing ritual above names its fix command. After fixing, re-stage and re-commit." >&2
  exit 1
fi
