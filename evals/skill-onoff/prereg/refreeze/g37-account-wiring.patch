+  // config dir; running them anyway would silently weaken that check, so the run is refused. A missing helper also stops (exit 2).
+  try {
+    const g = require('../../scripts/lib/eval-account.js').gate('run-d0gate-campaign');
+    if (g.state === 'broken') process.exit(g.exit);
