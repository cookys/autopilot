+});
+process.stdout.write(JSON.stringify(r));
+NODE
+)"
+
+# (a) tokens
+for tok in T-MSG T-AUTOPILOT T-QC T-EVIDENCE T-REVIEWMD T-DISP T-RECEIPT T-RAWLOG T-RENAME T-UNTRACKED; do
