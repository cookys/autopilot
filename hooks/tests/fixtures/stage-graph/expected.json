      "to": "plan"
    },
    {
      "from": "verify",
      "to": "implement"
    },
    {
      "from": "qc-gate",
      "to": "implement"
    },
    {
      "from": "code-review",
      "to": "implement",
      "except_urgency": [
        "urgent-low"
      ],
      "note": "on the urgent-low path code-review is post-finish and terminal: no edge back to implement; each finding opens a new S task"
    }
  ],
  "terminal": {"normal":"finish","urgent_low_with_code_review":"code-review"},
