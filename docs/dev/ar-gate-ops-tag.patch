+def read_ops(root):
+    """hippo ops (.hippo/ops/<record ULID>.jsonl, the source of truth; records/*.md is a view of them) -> {record id: [card ids]} from the live tags `key:card:<card id>`.
+    A tag op is {"field": "tags/<tag>", "value": true|false}; ops are replayed in file order so a later false removes the tag. Only tags are read, never bodies. None when root is unset or unreadable."""
+    if not root: return None
+    try: names = sorted(n for n in os.listdir(root) if n.endswith('.jsonl'))
+    except OSError: return None
+    out = {}
+    for n in names:
+        tags = {}
+        try: lines = open(os.path.join(root, n)).read().splitlines()
+        except OSError: continue
+        for l in lines:
+            try: op = json.loads(l)
+            except ValueError: continue
+            f = op.get('field') or ''
+            if f.startswith('tags/key:card:'): tags[f[len('tags/key:card:'):]] = op.get('value') is True
+        out[n[:-6]] = sorted(c for c, on in tags.items() if on)
+    return out
