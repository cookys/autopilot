# autopilot:pm-switchboard/1
# Systemd user service template for the 10-minute PM inbox batch switchboard.
# Substitute @REPO_PATH@ and @FLEET_REPO@ at install time, write under
# ~/.config/systemd/user/, then enable pm-switchboard.timer manually.
# Fixed rules only; opens no credential files.
[Unit]
Description=Autopilot PM inbox batch switchboard (fixed rules)

[Service]
Type=oneshot
UnsetEnvironment=AUTOPILOT_TOKEN_SEAT AUTOPILOT_SESSION_ID
Environment=AUTOPILOT_FLEET_REPO=@FLEET_REPO@
StandardInput=null
ExecStart=/usr/bin/env node @REPO_PATH@/scripts/pm-switchboard.js run
TimeoutStartSec=120
