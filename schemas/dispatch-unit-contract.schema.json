{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autopilot.local/schemas/dispatch-unit-contract.schema.json",
  "title": "dispatch-unit-contract",
  "description": "Closed v1 machine-readable dispatch-unit contract for GO/NO-GO checking.",
  "type": "object",
  "required": ["schema", "unit_id", "role", "goal", "spec", "base_sha", "depends_on", "scope", "go", "no_go", "output", "acceptance", "budget"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "enum": ["implementer", "verification-author", "reviewer", "explorer", "verifier", "planner"] },
    "deliberate_polarity": {
      "description": "Trusted declaration that this dispatch unit ships a deliberate red-before/green-after verification artifact.",
      "type": "boolean"
    },
    "goal": { "type": "string", "minLength": 1 },
    "spec": {
      "type": "object",
      "required": ["path", "section"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
      "minItems": 0
    },
    "scope": {
      "type": "object",
      "required": ["allow_paths", "deny_paths", "max_files", "max_diff_lines"],
      "properties": {
        "allow_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "deny_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 0
        },
        "generated_mirrors": {
          "type": "object",
          "required": ["command", "allow_paths"],
          "properties": {
            "command": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "allow_paths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "max_files": { "type": "integer", "minimum": 1 },
        "max_diff_lines": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "go": {
      "type": "object",
      "required": ["required_paths", "required_engine_role", "required_red_command"],
      "properties": {
        "required_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "required_engine_role": {
          "type": "string",
          "enum": ["implementer", "verification-author", "reviewer", "explorer", "verifier", "planner"]
        },
        "required_red_command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "no_go": {
      "type": "object",
      "required": [
        "on_missing_spec",
        "on_dirty_base",
        "on_unknown_engine",
        "on_quota_unavailable",
        "on_scope_violation",
        "on_budget_exceeded",
        "on_clarification_needed",
        "forbidden_actions"
      ],
      "properties": {
        "on_missing_spec": { "type": "string", "enum": ["stop"] },
        "on_dirty_base": { "type": "string", "enum": ["stop"] },
        "on_unknown_engine": { "type": "string", "enum": ["stop"] },
        "on_quota_unavailable": { "type": "string", "enum": ["stop"] },
        "on_scope_violation": { "type": "string", "enum": ["stop"] },
        "on_budget_exceeded": { "type": "string", "enum": ["stop"] },
        "on_clarification_needed": { "type": "string", "enum": ["stop"] },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["push", "merge", "network", "dependency-change"]
          },
          "minItems": 4,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["kind", "paths"],
      "properties": {
        "kind": { "type": "string", "enum": ["commit", "raw-artifact", "verdict", "diff"] },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "required_change_paths": {
          "description": "Exact paths that MUST appear in an effectful candidate diff. Non-empty unique exact subset of output.paths when present. Zero-change only via sealed no-op receipt.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "zero_diff_receipt": {
          "description": "Optional closed structured zero-diff receipt sealed into the dispatch unit (not ambient env).",
          "type": "object",
          "required": [
            "schema_version",
            "artifact_type",
            "base_sha",
            "acceptance_digest",
            "campaign_contract_digest",
            "strict_dispatch_digest",
            "campaign_id",
            "mission_lineage_id",
            "mission_policy_digest",
            "mission_graph_digest",
            "graph_node_id",
            "mission_noop_receipt_digest",
            "source_work_order_id",
            "source_work_order_digest",
            "path_byte_digests",
            "candidate_zero_change",
            "digest"
          ],
          "properties": {
            "schema_version": { "type": "integer", "const": 1 },
            "artifact_type": {
              "type": "string",
              "enum": ["campaign_zero_diff_receipt", "controller_zero_diff_receipt"]
            },
            "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "acceptance_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "campaign_contract_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "strict_dispatch_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "campaign_id": { "type": "string", "minLength": 1 },
            "mission_lineage_id": { "type": "string" },
            "mission_policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "mission_graph_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "graph_node_id": { "type": "string" },
            "mission_noop_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "source_work_order_id": { "type": "string", "minLength": 1 },
            "source_work_order_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "path_byte_digests": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "candidate_zero_change": { "type": "boolean", "const": true },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["argv", "exit"],
        "properties": {
          "argv": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "exit": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": ["wall_seconds", "max_attempts", "max_context_files"],
      "properties": {
        "wall_seconds": { "type": "integer", "minimum": 10, "maximum": 14400 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "max_context_files": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "campaign_projection": {
      "type": "object",
      "required": [
        "schema_version",
        "campaign_contract_sha256",
        "strict_dispatch_sha256",
        "campaign_id",
        "ticket",
        "campaign_base_sha",
        "branch",
        "stage",
        "generation",
        "root_run_id",
        "mission_lineage_id",
        "mission_policy_digest",
        "mission_graph_digest",
        "graph_node_id",
        "graph_node_digest",
        "runner",
        "model"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "campaign_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "strict_dispatch_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "campaign_id": { "type": "string", "pattern": "^campaign-v[12]-[0-9a-f]{64}$" },
        "ticket": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "campaign_base_sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "branch": { "type": "string", "minLength": 1 },
        "stage": {
          "type": "string",
          "pattern": "^campaign-implementation(?:#r(?:[2-9]|[1-9][0-9]+))?$"
        },
        "generation": { "type": "integer", "minimum": 0 },
        "root_run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "mission_lineage_id": { "type": "string", "minLength": 1 },
        "mission_policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mission_graph_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "graph_node_id": { "type": "string", "minLength": 1 },
        "graph_node_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runner": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
