{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/capability-evidence.schema.json",
  "title": "CapabilityEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_hash",
    "source",
    "source_ref",
    "state",
    "role",
    "scope",
    "scope_hash",
    "identity",
    "identity_hash",
    "grant_identity_hash",
    "issued_at",
    "observed_at",
    "expires_at",
    "methodology",
    "trials",
    "trial_set_hash",
    "revocation",
    "supersedes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_id": { "$ref": "#/$defs/sha256" },
    "evidence_hash": { "$ref": "#/$defs/sha256" },
    "source": {
      "enum": [
        "external_prior",
        "self_report",
        "ordinary_receipt",
        "internal_eval",
        "runtime_probe"
      ]
    },
    "source_ref": { "$ref": "#/$defs/token" },
    "state": {
      "enum": ["unknown", "provisional", "qualified", "degraded", "stale", "revoked"]
    },
    "role": { "$ref": "#/$defs/role" },
    "scope": { "$ref": "#/$defs/scope" },
    "scope_hash": { "$ref": "#/$defs/sha256" },
    "identity": { "$ref": "#/$defs/identity" },
    "identity_hash": { "$ref": "#/$defs/sha256" },
    "grant_identity_hash": { "$ref": "#/$defs/sha256" },
    "issued_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "methodology": { "$ref": "#/$defs/methodology" },
    "trials": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/trial" },
          { "$ref": "#/$defs/brain_trial" },
          { "$ref": "#/$defs/consult_trial" },
          { "$ref": "#/$defs/discuss_trial" }
        ]
      }
    },
    "trial_set_hash": { "$ref": "#/$defs/sha256" },
    "revocation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "observation_hash", "target_evidence_id"],
      "properties": {
        "reason": {
          "enum": ["critical_miss", "semantic_identity_drift", "probe_regression"]
        },
        "observation_hash": { "$ref": "#/$defs/sha256" },
        "target_evidence_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "administrations": { "$ref": "#/$defs/pooled_administrations" },
    "pooled": { "$ref": "#/$defs/pooled_totals" },
    "competence": { "$ref": "#/$defs/pooled_competence" },
    "tier1_terminated": { "type": "boolean" },
    "stop_reason": {
      "enum": ["tier1", "locked_fail", "locked_qualify", "complete", "continue"]
    }
  },
  "oneOf": [
    {
      "properties": {
        "source": { "const": "internal_eval" },
        "methodology": {
          "properties": {
            "kind": {
              "enum": [
                "role_eval",
                "owner_brain_seat",
                "consult_panel",
                "discuss_rounds"
              ]
            }
          }
        },
        "administrations": { "type": "array", "maxItems": 0 },
        "pooled": { "type": "null" },
        "competence": { "type": "null" },
        "tier1_terminated": { "type": "null" },
        "stop_reason": { "type": "null" }
      }
    },
    {
      "required": [
        "administrations",
        "pooled",
        "competence",
        "tier1_terminated",
        "stop_reason"
      ],
      "properties": {
        "source": { "const": "internal_eval" },
        "methodology": {
          "properties": {
            "kind": { "enum": ["consult_panel", "discuss_rounds"] }
          }
        },
        "administrations": { "$ref": "#/$defs/pooled_administrations", "minItems": 1 },
        "pooled": { "$ref": "#/$defs/pooled_totals" },
        "competence": { "$ref": "#/$defs/pooled_competence" },
        "tier1_terminated": { "type": "boolean" },
        "stop_reason": {
          "enum": ["tier1", "locked_fail", "locked_qualify", "complete", "continue"]
        }
      }
    },
    {
      "properties": {
        "source": { "const": "external_prior" },
        "state": {
          "enum": ["unknown", "provisional", "degraded", "stale", "revoked"]
        },
        "methodology": {
          "properties": {
            "kind": { "const": "external_prior" }
          }
        },
        "trials": { "maxItems": 0 }
      }
    },
    {
      "properties": {
        "source": { "const": "runtime_probe" },
        "state": {
          "enum": ["unknown", "provisional", "degraded", "stale", "revoked"]
        },
        "methodology": {
          "properties": {
            "kind": { "const": "runtime_probe" }
          }
        },
        "trials": { "maxItems": 0 }
      }
    },
    {
      "properties": {
        "source": { "const": "ordinary_receipt" },
        "state": {
          "enum": ["unknown", "provisional", "degraded", "stale", "revoked"]
        },
        "methodology": {
          "properties": {
            "kind": { "const": "ordinary_receipt" }
          }
        },
        "trials": { "maxItems": 0 }
      }
    },
    {
      "properties": {
        "source": { "const": "self_report" },
        "state": {
          "enum": ["unknown", "provisional", "degraded", "stale", "revoked"]
        },
        "methodology": {
          "properties": {
            "kind": { "const": "self_report" }
          }
        },
        "trials": { "maxItems": 0 }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "optional_tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "role": {
      "enum": ["owner", "implementer", "reviewer", "verification_author", "explorer", "consult", "discuss"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_classes", "domains", "languages", "tool_surface"],
      "properties": {
        "task_classes": { "$ref": "#/$defs/tokens" },
        "domains": { "$ref": "#/$defs/tokens" },
        "languages": { "$ref": "#/$defs/tokens" },
        "tool_surface": { "$ref": "#/$defs/optional_tokens" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "model_alias",
        "model_version",
        "family",
        "runner",
        "runner_version",
        "harness_version",
        "effort",
        "prompt_config_hash",
        "semantic_fingerprint",
        "containment_fingerprint",
        "identity_resolved"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/token" },
        "model_alias": { "$ref": "#/$defs/token" },
        "model_version": { "$ref": "#/$defs/token" },
        "family": { "$ref": "#/$defs/token" },
        "runner": { "$ref": "#/$defs/token" },
        "runner_version": { "$ref": "#/$defs/token" },
        "harness_version": { "$ref": "#/$defs/token" },
        "effort": { "$ref": "#/$defs/token" },
        "prompt_config_hash": { "$ref": "#/$defs/sha256" },
        "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
        "containment_fingerprint": { "$ref": "#/$defs/sha256" },
        "identity_resolved": { "type": "boolean" }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version",
        "corpus_version",
        "corpus_manifest_hash",
        "thresholds",
        "basis"
      ],
      "properties": {
        "kind": {
          "enum": [
            "role_eval",
            "owner_brain_seat",
            "consult_panel",
            "discuss_rounds",
            "external_prior",
            "runtime_probe",
            "ordinary_receipt",
            "self_report"
          ]
        },
        "name": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "corpus_version": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "corpus_manifest_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "thresholds": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_trials",
                "min_known_bad_cases",
                "min_critical_cases",
                "max_false_pass_critical",
                "min_clean_cases",
                "max_clean_false_positives"
              ],
              "properties": {
                "min_trials": { "type": "integer", "minimum": 2 },
                "min_known_bad_cases": { "type": "integer", "minimum": 1 },
                "min_critical_cases": { "type": "integer", "minimum": 1 },
                "max_false_pass_critical": { "type": "integer", "minimum": 0 },
                "min_clean_cases": { "type": "integer", "minimum": 1 },
                "max_clean_false_positives": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_trials",
                "min_plants_per_trial",
                "max_clean_false_positives",
                "max_critical_misses",
                "max_pair_deltas",
                "max_asks_on_legal_controls"
              ],
              "properties": {
                "min_trials": { "type": "integer", "minimum": 2 },
                "min_plants_per_trial": { "type": "integer", "minimum": 1 },
                "max_clean_false_positives": { "type": "integer", "minimum": 0 },
                "max_critical_misses": { "type": "integer", "minimum": 0 },
                "max_pair_deltas": { "type": "integer", "minimum": 0 },
                "max_asks_on_legal_controls": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_trials",
                "max_false_confidence",
                "max_precedence_misses",
                "max_authority_violations",
                "max_scope_drift",
                "max_oracle_misses",
                "max_protocol_violations"
              ],
              "properties": {
                "min_trials": { "type": "integer", "minimum": 2 },
                "max_false_confidence": { "type": "integer", "minimum": 0 },
                "max_precedence_misses": { "type": "integer", "minimum": 0 },
                "max_authority_violations": { "type": "integer", "minimum": 0 },
                "max_scope_drift": { "type": "integer", "minimum": 0 },
                "max_oracle_misses": { "type": "integer", "minimum": 0 },
                "max_protocol_violations": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min_trials",
                "max_sycophantic_capitulations",
                "max_evidence_blindness",
                "max_zero_information",
                "max_fabricated_anchors",
                "max_protocol_violations"
              ],
              "properties": {
                "min_trials": { "type": "integer", "minimum": 2 },
                "max_sycophantic_capitulations": { "type": "integer", "minimum": 0 },
                "max_evidence_blindness": { "type": "integer", "minimum": 0 },
                "max_zero_information": { "type": "integer", "minimum": 0 },
                "max_fabricated_anchors": { "type": "integer", "minimum": 0 },
                "max_protocol_violations": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "basis": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "cohort",
            "cohort_hash",
            "observation_hash",
            "dimensions",
            "applicability"
          ],
          "properties": {
            "cohort": { "$ref": "#/$defs/token" },
            "cohort_hash": { "$ref": "#/$defs/sha256" },
            "observation_hash": { "$ref": "#/$defs/sha256" },
            "dimensions": { "$ref": "#/$defs/tokens" },
            "applicability": { "$ref": "#/$defs/optional_tokens" }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "role_eval" },
            "corpus_version": { "$ref": "#/$defs/token" },
            "corpus_manifest_hash": { "$ref": "#/$defs/sha256" },
            "thresholds": { "type": "object" },
            "basis": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "owner_brain_seat" },
            "corpus_version": { "$ref": "#/$defs/token" },
            "corpus_manifest_hash": { "$ref": "#/$defs/sha256" },
            "thresholds": { "type": "object" },
            "basis": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "consult_panel" },
            "corpus_version": { "$ref": "#/$defs/token" },
            "corpus_manifest_hash": { "$ref": "#/$defs/sha256" },
            "thresholds": { "type": "object" },
            "basis": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "discuss_rounds" },
            "corpus_version": { "$ref": "#/$defs/token" },
            "corpus_manifest_hash": { "$ref": "#/$defs/sha256" },
            "thresholds": { "type": "object" },
            "basis": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "external_prior" },
            "corpus_version": { "type": "null" },
            "corpus_manifest_hash": { "type": "null" },
            "thresholds": { "type": "null" },
            "basis": { "type": "object" }
          }
        },
        {
          "properties": {
            "kind": { "const": "runtime_probe" },
            "corpus_version": { "type": "null" },
            "corpus_manifest_hash": { "type": "null" },
            "thresholds": { "type": "null" },
            "basis": { "type": "object" }
          }
        },
        {
          "properties": {
            "kind": { "const": "ordinary_receipt" },
            "corpus_version": { "type": "null" },
            "corpus_manifest_hash": { "type": "null" },
            "thresholds": { "type": "null" },
            "basis": { "type": "object" }
          }
        },
        {
          "properties": {
            "kind": { "const": "self_report" },
            "corpus_version": { "type": "null" },
            "corpus_manifest_hash": { "type": "null" },
            "thresholds": { "type": "null" },
            "basis": { "type": "object" }
          }
        }
      ]
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "observed_at",
        "known_bad_total",
        "known_bad_caught",
        "critical_total",
        "false_pass_critical",
        "clean_total",
        "clean_false_positives",
        "corpus_manifest_hash",
        "artifact_oracle",
        "mutation_validation"
      ],
      "properties": {
        "trial_id": { "$ref": "#/$defs/token" },
        "observed_at": { "type": "string", "format": "date-time" },
        "known_bad_total": { "type": "integer", "minimum": 1 },
        "known_bad_caught": { "type": "integer", "minimum": 0 },
        "critical_total": { "type": "integer", "minimum": 1 },
        "false_pass_critical": { "type": "integer", "minimum": 0 },
        "clean_total": { "type": "integer", "minimum": 1 },
        "clean_false_positives": { "type": "integer", "minimum": 0 },
        "corpus_manifest_hash": { "$ref": "#/$defs/sha256" },
        "artifact_oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "oracle_hash",
            "result_set_hash",
            "independent",
            "passed"
          ],
          "properties": {
            "kind": { "$ref": "#/$defs/token" },
            "oracle_hash": { "$ref": "#/$defs/sha256" },
            "result_set_hash": { "$ref": "#/$defs/sha256" },
            "independent": { "type": "boolean" },
            "passed": { "type": "boolean" }
          }
        },
        "mutation_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_id",
            "original_hash",
            "mutated_hash",
            "original_verdict",
            "mutated_verdict",
            "oracle_rejected"
          ],
          "properties": {
            "target_id": { "$ref": "#/$defs/token" },
            "original_hash": { "$ref": "#/$defs/sha256" },
            "mutated_hash": { "$ref": "#/$defs/sha256" },
            "original_verdict": { "enum": ["pass", "fail"] },
            "mutated_verdict": { "enum": ["pass", "fail"] },
            "oracle_rejected": { "type": "boolean" }
          }
        }
      }
    },
    "brain_trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "observed_at",
        "stop_reason",
        "construct_scope",
        "plants_total",
        "plants_caught",
        "clean_false_positives",
        "fairness_cases_total",
        "fairness_correctness_failures",
        "pair_delta_count",
        "hard_fail_count",
        "ask_floor_violations",
        "convergence_terminal",
        "economy_ok",
        "verification_actions",
        "findings_closed",
        "spend_tokens",
        "decision_trace_hash",
        "round_stream_hash",
        "corpus_manifest_hash"
      ],
      "properties": {
        "trial_id": { "$ref": "#/$defs/token" },
        "observed_at": { "type": "string", "format": "date-time" },
        "stop_reason": { "enum": ["completed", "early_end", "malformed", "insufficient_budget"] },
        "construct_scope": { "const": "per-round-exam.long-horizon-production-audit" },
        "plants_total": { "type": "integer", "minimum": 0 },
        "plants_caught": { "type": "integer", "minimum": 0 },
        "clean_false_positives": { "type": "integer", "minimum": 0 },
        "fairness_cases_total": { "type": "integer", "minimum": 0 },
        "fairness_correctness_failures": { "type": "integer", "minimum": 0 },
        "pair_delta_count": { "type": "integer", "minimum": 0 },
        "hard_fail_count": { "type": "integer", "minimum": 0 },
        "ask_floor_violations": { "type": "integer", "minimum": 0 },
        "convergence_terminal": { "type": "boolean" },
        "economy_ok": { "type": "boolean" },
        "verification_actions": { "type": "integer", "minimum": 0 },
        "findings_closed": { "type": "integer", "minimum": 0 },
        "spend_tokens": { "type": "integer", "minimum": 0 },
        "decision_trace_hash": { "$ref": "#/$defs/sha256" },
        "round_stream_hash": { "$ref": "#/$defs/sha256" },
        "corpus_manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "consult_trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "observed_at",
        "corpus_manifest_hash",
        "cases_total",
        "cases_passed",
        "false_confidence",
        "precedence_misses",
        "authority_violations",
        "scope_drift",
        "oracle_misses",
        "protocol_violations",
        "response_stream_hash"
      ],
      "properties": {
        "trial_id": { "$ref": "#/$defs/token" },
        "observed_at": { "type": "string", "format": "date-time" },
        "corpus_manifest_hash": { "$ref": "#/$defs/sha256" },
        "cases_total": { "type": "integer", "minimum": 1 },
        "cases_passed": { "type": "integer", "minimum": 0 },
        "false_confidence": { "type": "integer", "minimum": 0 },
        "precedence_misses": { "type": "integer", "minimum": 0 },
        "authority_violations": { "type": "integer", "minimum": 0 },
        "scope_drift": { "type": "integer", "minimum": 0 },
        "oracle_misses": { "type": "integer", "minimum": 0 },
        "protocol_violations": { "type": "integer", "minimum": 0 },
        "response_stream_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "discuss_trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "observed_at",
        "corpus_manifest_hash",
        "cases_total",
        "cases_passed",
        "sycophantic_capitulations",
        "evidence_blindness",
        "zero_information",
        "fabricated_anchors",
        "protocol_violations",
        "transcript_stream_hash"
      ],
      "properties": {
        "trial_id": { "$ref": "#/$defs/token" },
        "observed_at": { "type": "string", "format": "date-time" },
        "corpus_manifest_hash": { "$ref": "#/$defs/sha256" },
        "cases_total": { "type": "integer", "minimum": 1 },
        "cases_passed": { "type": "integer", "minimum": 0 },
        "sycophantic_capitulations": { "type": "integer", "minimum": 0 },
        "evidence_blindness": { "type": "integer", "minimum": 0 },
        "zero_information": { "type": "integer", "minimum": 0 },
        "fabricated_anchors": { "type": "integer", "minimum": 0 },
        "protocol_violations": { "type": "integer", "minimum": 0 },
        "transcript_stream_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "pooled_administrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run", "per_trial", "per_case_outcomes"],
        "properties": {
          "run": { "type": "integer", "minimum": 1 },
          "per_trial": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["trial", "cases_total", "cases_passed"],
              "properties": {
                "trial": { "type": "integer", "minimum": 1 },
                "cases_total": { "type": "integer", "minimum": 0 },
                "cases_passed": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "per_case_outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["case_id", "outcome", "tier"],
              "properties": {
                "case_id": { "$ref": "#/$defs/token" },
                "outcome": { "$ref": "#/$defs/token" },
                "tier": { "$ref": "#/$defs/token" }
              }
            }
          }
        }
      }
    },
    "pooled_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passes",
        "eligible_full_N",
        "tier2_misses_by_class",
        "harness_excluded"
      ],
      "properties": {
        "passes": { "type": "integer", "minimum": 0 },
        "eligible_full_N": { "type": "integer", "minimum": 1 },
        "tier2_misses_by_class": {
          "type": "object",
          "additionalProperties": true
        },
        "harness_excluded": { "type": "integer", "minimum": 0 }
      }
    },
