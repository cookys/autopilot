# Dated eval result dirs that are noise — non-baseline runs.
# Baseline runs (2026-05-14_122359 + _155325) are explicitly tracked.
skill-creator-workspace/results/*/2026-05-14_154034/
# Task-tree engine: index.json is derived from events.jsonl and must not be
# tracked. index.* also covers the same-dir mktemp temp file (index.XXXXXX)
# that an interrupted rebuild could leave behind. ** (not *) so archived
# projects under _archive/<proj>/ stay covered too.
docs/projects/**/tree/index.*
# Ephemeral flock sidecar created by tree.sh locked_append.
docs/projects/**/tree/events.jsonl.lock
