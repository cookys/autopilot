{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/profile-cutover-snapshot.schema.json",
  "title": "ProfileCutoverSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "project_default",
    "candidate_default",
    "rollback",
    "supported_hosts",
    "profile_sources",
    "context_measurements",
    "effectful_guided_compatibility",
    "fallback_tests",
    "critical_false_passes_attributed_to_reduction",
    "assurance_invariance",
    "dogfood_window",
    "dogfood_receipts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "project_default": { "enum": ["guided", "adaptive"] },
    "candidate_default": { "const": "adaptive" },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "value"],
      "properties": {
        "setting": { "const": "governance.guidance_profile" },
        "value": { "const": "guided" }
      }
    },
    "supported_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "profile_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guided", "autonomous"],
      "properties": {
        "guided": { "$ref": "#/$defs/profile_source" },
        "autonomous": { "$ref": "#/$defs/profile_source" }
      }
    },
    "context_measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/context_measurement" }
    },
    "effectful_guided_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_hash"],
      "properties": {
        "status": { "enum": ["observed", "missing"] },
        "receipt_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "fallback_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_drift",
        "capability_expiry",
        "capability_demotion",
        "replacement_reresolution",
        "profile_change_fresh_session"
      ],
      "properties": {
        "identity_drift": { "$ref": "#/$defs/gate_state" },
        "capability_expiry": { "$ref": "#/$defs/gate_state" },
        "capability_demotion": { "$ref": "#/$defs/gate_state" },
        "replacement_reresolution": { "$ref": "#/$defs/gate_state" },
        "profile_change_fresh_session": { "$ref": "#/$defs/gate_state" }
      }
    },
    "critical_false_passes_attributed_to_reduction": {
      "type": "integer",
      "minimum": 0
    },
    "assurance_invariance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high_risk_assurance_unchanged", "cross_family_review"],
      "properties": {
        "high_risk_assurance_unchanged": { "$ref": "#/$defs/gate_state" },
        "cross_family_review": { "$ref": "#/$defs/gate_state" }
      }
    },
    "dogfood_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "window_id",
        "started_at",
        "ended_at",
        "dispatched_task_ids",
        "receipt_set_hash"
      ],
      "properties": {
        "status": { "enum": ["observed", "missing"] },
        "window_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" },
        "dispatched_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "receipt_set_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dogfood_receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/dogfood_receipt" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gate_state": {
      "enum": ["pass", "fail", "unverified"]
    },
    "profile_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_hash", "control_bytes"],
      "properties": {
        "profile_hash": { "$ref": "#/$defs/sha256" },
        "control_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "context_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "deployment_identity_hash",
        "measured_at",
        "token_source",
        "guided_control_tokens",
        "autonomous_control_tokens",
        "isolation_receipt_hash",
        "fresh_session_switch"
      ],
      "properties": {
        "host": { "$ref": "#/$defs/token" },
        "deployment_identity_hash": { "$ref": "#/$defs/sha256" },
        "measured_at": { "type": "string", "format": "date-time" },
        "token_source": { "$ref": "#/$defs/token" },
        "guided_control_tokens": { "type": "integer", "minimum": 1 },
        "autonomous_control_tokens": { "type": "integer", "minimum": 1 },
        "isolation_receipt_hash": { "$ref": "#/$defs/sha256" },
        "fresh_session_switch": { "type": "boolean" }
      }
    },
    "dogfood_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "task_id",
        "profile_session_id",
        "risk",
        "profile",
        "status",
        "started_at",
        "completed_at",
        "owner_identity_hash",
        "owner_family",
        "reviewer_family",
        "owner_qualification_receipt_id",
        "owner_qualified_at",
        "owner_qualification_expires_at",
        "independent_acceptance_receipt_hash",
        "acceptance_passed",
        "critical_false_pass_attributed_to_reduction",
        "reviewer_catches",
        "rework_cycles",
        "wall_time_ms",
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/sha256" },
        "task_id": { "$ref": "#/$defs/token" },
        "profile_session_id": { "$ref": "#/$defs/token" },
        "risk": { "const": "low" },
        "profile": { "const": "autonomous" },
        "status": { "const": "completed" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "owner_identity_hash": { "$ref": "#/$defs/sha256" },
        "owner_family": { "$ref": "#/$defs/token" },
        "reviewer_family": { "$ref": "#/$defs/token" },
        "owner_qualification_receipt_id": { "$ref": "#/$defs/sha256" },
        "owner_qualified_at": { "type": "string", "format": "date-time" },
        "owner_qualification_expires_at": { "type": "string", "format": "date-time" },
        "independent_acceptance_receipt_hash": { "$ref": "#/$defs/sha256" },
        "acceptance_passed": { "type": "boolean" },
        "critical_false_pass_attributed_to_reduction": { "type": "boolean" },
        "reviewer_catches": { "type": "integer", "minimum": 0 },
        "rework_cycles": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 1 },
        "input_tokens": { "type": "integer", "minimum": 1 },
        "output_tokens": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
