   const ver = claudeVersion();
diff --git a/evals/skill-onoff/run-skill-onoff-eval-bpack.sh b/evals/skill-onoff/run-skill-onoff-eval-bpack.sh
index 689f3c19e..be0fd8c48 100755
--- a/evals/skill-onoff/run-skill-onoff-eval-bpack.sh
+++ b/evals/skill-onoff/run-skill-onoff-eval-bpack.sh
@@ -269,6 +269,19 @@ fi
 # config dir can leak the operator's installed plugins into the OFF arm (G1-F9),
 # so both HOME and CLAUDE_CONFIG_DIR are always exported to scratch paths.
 mkdir -p "$SCRATCH_CONFIG"
+# G37 W5 (A12): this runner needs its own scratch HOME and CLAUDE_CONFIG_DIR (the OFF arm must not see the operator's plugins), and the
+# account layer replaces both with the alias dirs. So with an account registry the run is refused (exit 2) until a cell design for
+# account-backed arms exists; a broken registry or a missing helper also stops here (exit 2), before any spawn and before any credentials copy.
+if [ "$RUNNER" = "cc" ]; then
+  _EA_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../scripts/lib" 2>/dev/null && pwd)/eval-account.sh"
+  [ -r "$_EA_LIB" ] || { echo "eval-account: the account-layer helper $_EA_LIB is missing; refusing to start (nothing was spawned, no credentials copied)" >&2; exit 2; }
+  . "$_EA_LIB"
+  eval_account_probe skill-onoff || exit $?
+  if [ "${EVAL_ACCOUNT_ACTIVE:-0}" = 1 ]; then
+    echo "skill-onoff: an account registry is configured; this runner's arms need their own HOME and CLAUDE_CONFIG_DIR, which the account layer replaces, so the run is refused (plan G37 A12)" >&2
+    exit 2
+  fi
+fi
 if [ "$RUNNER" = "cc" ] && [ -f "${HOME}/.claude/.credentials.json" ]; then
   cp "${HOME}/.claude/.credentials.json" "$SCRATCH_CONFIG/"
   chmod 600 "$SCRATCH_CONFIG/.credentials.json"
