{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schemas/review-result.schema.json",
  "title": "ReviewResult",
  "type": "object",
  "required": ["status", "runner", "model", "verdict", "findings", "no_finding_proof", "raw_log", "error", "usage"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["reviewed", "no_verdict", "precondition_failed"]
    },
    "runner": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "verdict": {
      "type": ["string", "null"],
      "enum": ["SHIP-AS-IS", "FIX-THEN-SHIP", null]
    },
    "findings": {
      "type": "string"
    },
    "no_finding_proof": {
      "type": ["string", "null"]
    },
    "raw_log": {
      "type": ["string", "null"]
    },
    "error": {
      "type": ["string", "null"]
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["total_tokens", "input_tokens", "output_tokens", "cache_read_tokens", "source"],
      "properties": {
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "verdict": { "const": "SHIP-AS-IS" },
        "no_finding_proof": {
          "type": "string",
          "minLength": 1,
          "pattern": "^checked=.+;\\s*evidence=.+;\\s*conclusion=.+$"
        }
      }
    },
    {
      "properties": {
        "verdict": { "enum": ["FIX-THEN-SHIP", null] },
        "no_finding_proof": { "type": "null" }
      }
    }
  ],
  "additionalProperties": false
}
