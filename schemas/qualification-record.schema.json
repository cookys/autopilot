{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cookys.github.io/model-dyno/schemas/qualification-record.schema.json",
 "title": "qualification record (benchmarks/qualification/<workspace>/<record>.json). v2 is a superset of v1: schema 1 legacy records stay valid unchanged; schema 2 adds producer, transcript_hash, administered_at, origin_host_class, evidence_ref",
 "oneOf": [
  {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "record_id",
    "record_id_basis",
    "source",
    "seat",
    "verdict",
    "raw",
    "imported_at"
   ],
   "properties": {
    "source": {
     "type": "object"
    },
    "verdict": {
     "type": "object"
    },
    "raw": {
     "type": "object"
    },
    "evidence": {
     "type": [
      "object",
      "null"
     ]
    },
    "cost": {
     "type": [
      "object",
      "null"
     ]
    },
    "latency": {
     "type": [
      "object",
      "null"
     ]
    },
    "imported_at": {
     "type": "string",
     "minLength": 1
    },
    "importer": {
     "type": "string"
    },
    "origin_host": {
     "type": "string"
    },
    "schema": {
     "type": "integer",
     "enum": [
      1
     ]
    },
    "record_id": {
     "$ref": "#/$defs/sha256_hex"
    },
    "record_id_basis": {
     "type": "string",
     "enum": [
      "evidence_id",
      "row_digest"
     ]
    },
    "seat": {
     "$ref": "#/$defs/seat12"
    }
   },
   "title": "schema 1 = legacy record exactly as committed by the importer (31 records at P1); record_id keeps its original basis and is never recomputed"
  },
  {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "record_id",
    "record_id_basis",
    "source",
    "seat",
    "verdict",
    "raw",
    "imported_at",
    "producer",
    "transcript_hash",
    "administered_at",
    "origin_host_class"
   ],
   "properties": {
    "source": {
     "type": "object"
    },
    "verdict": {
     "type": "object"
    },
    "raw": {
     "type": "object"
    },
    "evidence": {
     "type": [
      "object",
      "null"
     ]
    },
    "cost": {
     "type": [
      "object",
      "null"
     ]
    },
    "latency": {
     "type": [
      "object",
      "null"
     ]
    },
    "imported_at": {
     "type": "string",
     "minLength": 1
    },
    "importer": {
     "type": "string"
    },
    "origin_host": {
     "type": "string"
    },
    "producer": {
     "type": "string",
     "minLength": 1
    },
    "transcript_hash": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "administered_at": {
     "$ref": "#/$defs/ts_utc"
    },
    "origin_host_class": {
     "$ref": "#/$defs/origin_host_class"
    },
    "evidence_ref": {
     "$ref": "#/$defs/evidence_ref"
    },
    "supersedes": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{64}$",
     "title": "record_id this record replaces (e.g. the same administration relabelled to effort default); the target must already exist, may not be this record; the target file is never modified"
    },
    "schema": {
     "type": "integer",
     "enum": [
      2
     ]
    },
    "record_id": {
     "$ref": "#/$defs/sha256_hex"
    },
    "record_id_basis": {
     "type": "string",
     "enum": [
      "v1:producer,transcript_hash,seat,corpus_version,administered_at"
     ]
    },
    "seat": {
     "$ref": "#/$defs/seat6_record"
    }
   },
   "title": "schema 2 = record keyed by record_id = sha256(canonical_json([producer, transcript_hash, seat(6), corpus_version, administered_at]))"
  }
 ],
 "$defs": {
  "ts_utc": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
   "title": "UTC timestamp ending in Z, e.g. 2026-10-16T08:00:00Z (millis optional)"
  },
  "sha256_hex": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "title": "lowercase sha256 hex (64 chars)"
  },
  "origin_host_class": {
   "type": "string",
   "enum": [
    "local-gpu",
    "cloud-api"
   ],
   "title": "origin_host_class: where the MODEL ran, NOT where the harness ran. A cloud-API subject examined from a local machine is cloud-api; local-gpu only when the model weights were served on a local GPU. Never a hostname."
  },
  "evidence_ref": {
   "type": [
    "string",
    "null"
   ],
   "minLength": 1,
   "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
   "title": "evidence_ref: path relative to the registry repo root, never a URL, never absolute, no '..'; null when no tracked per-cell evidence can be named"
  },
  "seat12": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "engine",
    "runner",
    "role",
    "effort"
   ],
   "properties": {
    "engine": {
     "type": "string",
     "minLength": 1
    },
    "runner": {
     "type": "string",
     "minLength": 1
    },
    "role": {
     "type": "string",
     "minLength": 1
    },
    "effort": {
     "type": [
      "string",
      "null"
     ]
    },
    "family": {
     "type": "string"
    },
    "model": {
     "type": [
      "string",
      "null"
     ]
    },
    "model_version": {
     "type": "string"
    },
    "version_source": {
     "type": "string"
    },
    "runner_version": {
     "type": "string"
    },
    "harness_version": {
     "type": "string"
    },
    "prompt_config_hash": {
     "type": "string"
    },
    "corpus_version": {
     "type": "string"
    }
   },
   "title": "legacy seat: effort/model may be null (runner default tier / unrecorded)"
  },
  "seat6_record": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "engine",
    "model",
    "model_version",
    "runner",
    "role",
    "effort",
    "prompt_config_hash",
    "corpus_version"
   ],
   "properties": {
    "engine": {
     "type": "string",
     "minLength": 1
    },
    "model": {
     "type": "string",
     "minLength": 1
    },
    "model_version": {
     "type": "string",
     "minLength": 1
    },
    "runner": {
     "type": "string",
     "minLength": 1
    },
    "role": {
     "type": "string",
     "minLength": 1
    },
    "effort": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
     "title": "effort tier token, or null for a legacy row that recorded no effort. null is hashed as JSON null; it is NOT the same seat as 'default' (= effort deliberately not sent, endpoint default ran)"
    },
    "family": {
     "type": "string",
     "minLength": 1
    },
    "version_source": {
     "type": "string",
     "minLength": 1
    },
    "runner_version": {
     "type": "string",
     "minLength": 1
    },
    "harness_version": {
     "type": "string",
     "minLength": 1
    },
    "prompt_config_hash": {
     "type": "string",
     "minLength": 1
    },
    "corpus_version": {
     "type": "string",
     "minLength": 1
    }
   },
   "title": "v2 record seat: the six hashed strings plus corpus_version, prompt_config_hash and optional environment facts"
  }
 }
}
