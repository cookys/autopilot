#!/usr/bin/env bash
# autopilot pre-commit gate — run version-sync drift check.
#
# Activated by:  scripts/install-hooks.sh  (sets core.hooksPath=.githooks)
#
# What it checks (Phase 0.5):
#   - sync-version.js --check: .claude-plugin/plugin.json (canonical) vs
#     all mirrors (plugin.json, marketplace.json, hooks/README.md, README.md).
#     Exits 1 if any mirror drifts.
#
# Future phases will add more checks here (e.g. sync-agent-bodies.sh --check
# in Phase 3). Each new check should be additive and fail-fast.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- sync-version drift check ---
if ! node scripts/sync-version.js --check >/dev/null 2>&1; then
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "pre-commit: version-manifest drift detected" >&2
  echo "─────────────────────────────────────────────────────────────" >&2
  node scripts/sync-version.js --check >&2 || true
  echo "" >&2
  echo "To fix: edit .claude-plugin/plugin.json (canonical) then run sync-version.js" >&2
  echo "with the new args, then re-commit." >&2
  exit 1
fi

# --- sync-agent-bodies drift check ---
# agents/<role>.md (with frontmatter) → .opencode/agent-bodies/<role>.body.md (no frontmatter)
# OpenCode references agent-bodies/ via {file:..} cross-layer. Drift means body file is stale.
if ! ./scripts/sync-agent-bodies.sh --check >/dev/null 2>&1; then
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "pre-commit: agent body sync drift detected" >&2
  echo "─────────────────────────────────────────────────────────────" >&2
  ./scripts/sync-agent-bodies.sh --check >&2 || true
  echo "" >&2
  echo "To fix:" >&2
  echo "  ./scripts/sync-agent-bodies.sh && git add .opencode/agent-bodies/" >&2
  exit 1
fi

# --- blind-dispatch.md issue-ref anti-rot grep (P1) ---
# The "Clarifying questions survive auto-approve" subsection cites the two codex
# issues that establish the auto-approve-vs-question distinction. If a reword
# drops them, the claim loses its provenance. Keep this assertion in lockstep
# with that subsection.
if ! grep -q 'issues/10187' references/blind-dispatch.md || ! grep -q 'issues/2138' references/blind-dispatch.md; then
  echo "pre-commit: references/blind-dispatch.md lost a required issue ref (#10187 and/or #2138)" >&2
  exit 1
fi

# --- canonical cross-file invariant check (P2) ---
# Guards invariants the byte-for-byte mirror checks can't see (files intentionally
# not byte-equal): repeated severity vocabulary + reviewer→code-review reference anchor.
if ! ./scripts/check-canonical-invariants.sh >/dev/null 2>&1; then
  echo "─────────────────────────────────────────────────────────────" >&2
  echo "pre-commit: canonical cross-file invariant broken" >&2
  echo "─────────────────────────────────────────────────────────────" >&2
  ./scripts/check-canonical-invariants.sh >&2 || true
  echo "" >&2
  echo "To fix: restore the missing phrase/anchor, OR if you reworded a guarded rule," >&2
  echo "update the inline seed table in scripts/check-canonical-invariants.sh in the" >&2
  echo "SAME commit (see the script header's same-commit ritual)." >&2
  exit 1
fi
