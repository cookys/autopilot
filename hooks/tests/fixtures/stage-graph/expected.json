    "source": "docs/plans/2026-10-06-dev-flow-stage-graph.md section 2.7 (hand-derived; independent of scripts/stage-graph.js, which P1 must reproduce)",
    "fields": {
      "id": "size.feat|bug.urgency.research.uN",
      "urgency": "normal | urgent-low (urgent, no high risk) | urgent-high (urgent, high risk)",
      "research": "research | noresearch (L/XL only) | na",
      "units": "N >= 1; the happy-path walk repeats (implement, verify) N times",
      "entry": "first node a first stage write must target",
      "unit_kind": "phase | deliverable (XL) | null (XS has no unit loop)",
      "nodes": "ordered unique node set (first occurrence in walk)",
      "walk": "full ordered happy-path sequence, no repairs, units expanded"
    },
    "rules": [
      "XS: implement, qc-gate, finish. XS has no verify node so there is no unit loop: units is carried but ignored (units_ignored:true on the units=3 cells)",
      "S: implement, verify, qc-gate, finish; M: plan, implement, verify, code-review, qc-gate, finish; units repeat (implement, verify)",
      "L: intent, [research], proposal, plan, plan-review, (implement, verify)xN, code-review, qc-gate, finish",
      "XL: as L with unit.kind deliverable, ONE code-review after all units",
      "--bug: diagnose replaces the leading node (XS/S: before implement; M: before plan; L/XL: replaces intent, research stays optional)",
      "urgent-low: code-review moves AFTER finish and is terminal (M, L, XL); XS and S have no code-review so urgency changes only the flag",
      "urgent-high: the normal order; high risk is carried by the urgency axis and has no other effect on walks"
    ],
    "cell_count": 84
  },
  "node_ids": ["intent","diagnose","research","proposal","plan","plan-review","implement","verify","code-review","qc-gate","finish"],
  "loop_backs": [
