+                c.insert(key.to_string(), v.clone());
+            }
+        }
+        if let Some(v) = cw.get("current_usage") {
+            c.insert("current_usage".to_string(), v.clone());
+        }
+        obj.insert("context_window".to_string(), serde_json::Value::Object(c));
+    }
+    record
 }
 
